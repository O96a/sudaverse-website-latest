{
  "name": "site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "publish:root": "astro build && node scripts/publish-root.mjs",
    "check": "astro check",
    "test:integrity": "node scripts/check-integrity.mjs",
    "test:links": "node scripts/check-links.mjs",
    "test:secrets": "node scripts/check-secrets.mjs",
    "test:root": "node scripts/check-root-sync.mjs",
    "verify": "npm run check && npm run build && npm run test:integrity && npm run test:links && npm run test:secrets"
  },
  "dependencies": {
    "@astrojs/react": "^6.0.6",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@xyflow/react": "^12.11.6",
    "astro": "^7.3.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sharp": "^0.35.4"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^6.0.3"
  }
