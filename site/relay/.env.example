# Sudaverse contact relay: configuration.
# Copy to .env and fill in. Never commit .env. All values below are intentionally empty:
# an empty value means "use the default" (or "channel off" for the channel variables).
# Each delivery channel (email, Telegram, Signal) is enabled only when its variables are set.

# ---------------------------------------------------------------- server

# Port to listen on when running without Docker. Default 8787. (Docker: fixed at 8787.)
PORT=

# Interface to bind. Default 0.0.0.0. Use 127.0.0.1 when a reverse proxy runs on the same host
# and nothing else should reach the relay.
HOST=

# Set to "production" in any real deployment (the Docker image and compose file do this).
# Outside production the default ALLOWED_ORIGINS also include http://localhost:4321 and
# http://127.0.0.1:8090 for local development.
NODE_ENV=

# Comma-separated browser origins allowed to POST /contact (scheme + host + optional port, no path).
# Default: https://www.sudaverse.com,https://sudaverse.com
# Wildcards are not supported. Setting this replaces the defaults entirely.
ALLOWED_ORIGINS=

# ---------------------------------------------------------------- abuse limits

# Set to 1 when exactly one reverse proxy (Caddy, nginx, a platform load balancer) sits in front of
# the relay, so the visitor address is read from X-Forwarded-For. Use 2 for two proxies in a chain.
# Leave empty when the relay is reachable directly: the header is then ignored (it can be forged).
TRUST_PROXY=

# Requests allowed per visitor address per window. Default 5. Every POST counts, valid or not.
RATE_LIMIT=

# Length of that window in seconds. Default 600 (10 minutes).
RATE_WINDOW_SECONDS=

# Largest accepted request body in bytes. Default 16384.
MAX_BODY_BYTES=

# ---------------------------------------------------------------- email over SMTP

# SMTP server of your provider (see README for provider options). Setting this enables email.
SMTP_HOST=

# 587 (STARTTLS, the default) or 465 (implicit TLS; also set SMTP_SECURE=true).
SMTP_PORT=

# false = connect in clear text then upgrade with STARTTLS (port 587). true = TLS from the start (port 465).
SMTP_SECURE=

# Credentials for the SMTP server. Some providers use an API key as the password.
SMTP_USER=
SMTP_PASS=

# With SMTP_SECURE=false the relay refuses to continue without STARTTLS (credentials are never sent
# in clear text). Set to false only for a local test server such as MailHog. Default true.
SMTP_REQUIRE_TLS=

# Fixed sender. Must be an address on a domain you have verified with the SMTP provider.
# The visitor's address is never used here; it goes in Reply-To.
# Default: Sudaverse website <no-reply@sudaverse.com>
MAIL_FROM=

# Where messages are delivered. Comma-separated for several. Default: info@sudaverse.com
MAIL_TO=

# ---------------------------------------------------------------- Telegram (optional)

# Bot token from @BotFather and the id of the chat that should receive messages. Both required.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------- Signal (optional, community gateway)

# Base URL of a signal-cli-rest-api gateway, e.g. http://signal:8080 with the compose profile "signal".
SIGNAL_API_URL=

# The Signal number the gateway is registered or linked as, in E.164 form (+ country code and number).
SIGNAL_NUMBER=

# Comma-separated recipients in E.164 form.
SIGNAL_RECIPIENTS=
