---
import Icon from './Icon.astro';

interface Props {
  href?: string;
  /** primary: Nile blue. convert: the logo blue, reserved for "Talk to Us". secondary: outline. light / outline-deep: for deep sections. */
  variant?: 'primary' | 'convert' | 'secondary' | 'light' | 'outline-deep';
  size?: 'md' | 'sm';
  arrow?: boolean;
  external?: boolean;
  type?: 'button' | 'submit';
  class?: string;
  [attr: string]: unknown;
}
const {
  href,
  variant = 'primary',
  size = 'md',
  arrow = false,
  external = false,
  type = 'button',
  class: className,
  ...rest
} = Astro.props;
const Tag = href ? 'a' : 'button';
const extra = href
  ? { href, ...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {}) }
  : { type };
---

<Tag class:list={['btn', `btn--${variant}`, `btn--${size}`, className]} {...extra} {...rest}>
  <slot />
  {arrow && <Icon name="arrow" size={18} directional class="btn__arrow" />}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    min-block-size: 3rem;
    padding-inline: 1.4rem;
    border: 1.5px solid transparent;
    border-radius: var(--radius-pill);
    font-size: var(--fs-300);
    font-weight: 620;
    line-height: 1.3;
    text-decoration: none;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--dur-2) var(--ease-out),
      border-color var(--dur-2) var(--ease-out),
      color var(--dur-2) var(--ease-out),
      transform var(--dur-2) var(--ease-out);
  }
  .btn--sm {
    min-block-size: 2.75rem;
    padding-inline: 1.1rem;
    font-size: var(--fs-200);
  }
  .btn:active {
    transform: translateY(1px);
  }
  .btn :global(.btn__arrow) {
    transition: translate var(--dur-2) var(--ease-out);
  }
  .btn:hover :global(.btn__arrow) {
    translate: 3px 0;
  }
  :global([dir='rtl']) .btn:hover :global(.btn__arrow) {
    translate: -3px 0;
  }

  .btn--primary {
    background: var(--color-action);
    color: var(--color-action-text);
  }
  .btn--primary:hover {
    background: var(--color-action-hover);
    color: var(--color-action-text);
  }
  .btn--convert {
    background: var(--color-convert);
    color: var(--color-convert-text);
  }
  .btn--convert:hover {
    background: var(--color-convert-hover);
    color: var(--color-convert-text);
  }
  .btn--secondary {
    background: var(--white);
    border-color: var(--nile-800);
    color: var(--nile-800);
  }
  .btn--secondary:hover {
    background: var(--nile-800);
    color: var(--white);
  }
  .btn--light {
    background: var(--paper);
    color: var(--nile-900);
  }
  .btn--light:hover {
    background: var(--white);
    color: var(--nile-950);
  }
  .btn--outline-deep {
    border-color: color-mix(in srgb, var(--paper) 55%, transparent);
    color: var(--paper);
  }
  .btn--outline-deep:hover {
    background: color-mix(in srgb, var(--paper) 14%, transparent);
    border-color: var(--paper);
    color: var(--paper);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn,
    .btn :global(.btn__arrow) {
      transition-duration: 0.01ms;
    }
    .btn:hover :global(.btn__arrow) {
      translate: none;
    }
  }
</style>
