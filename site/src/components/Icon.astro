  flask: '<path d="M9.5 3.5h5M10.5 3.5v5.2l-5.3 9.1a1.9 1.9 0 0 0 1.6 2.9h10.4a1.9 1.9 0 0 0 1.6-2.9l-5.3-9.1V3.5M7.7 14.5h8.6"/>',
  paper: '<path d="M7 3.5h7.5L19 8v12.5H7zM14.5 3.5V8H19M9.8 12.5h6.4M9.8 15.5h6.4M9.8 18.5h3.5"/>',
  users: '<circle cx="9" cy="8.5" r="3.2"/><path d="M3 19.5c0-3.4 2.7-5.5 6-5.5s6 2.1 6 5.5M16 5.6a3.2 3.2 0 0 1 0 5.8M17.5 14.3c2.2.6 3.5 2.4 3.5 5.2"/>',
