---
/**
 * One consistent authored icon set: 24px grid, 1.75 stroke, round joins.
 * Directional icons (arrow, chevron-start) mirror automatically in RTL via .icon-dir.
 */
interface Props {
  name:
    | 'arrow'
    | 'external'
    | 'menu'
    | 'close'
    | 'chevron'
    | 'chat'
    | 'check'
    | 'mail'
    | 'book'
    | 'sprout'
    | 'globe'
    | 'shield'
    | 'waves'
    | 'code'
    | 'flask'
    | 'paper'
    | 'users'
    | 'building'
    | 'layers'
    | 'briefcase'
    | 'landmark'
    | 'cap'
    | 'whatsapp'
    | 'signal'
    | 'telegram';
  size?: number;
  directional?: boolean;
  class?: string;
}
const { name, size = 20, directional = false, class: className } = Astro.props;

const paths: Record<Props['name'], string> = {
  arrow: '<path d="M4 12h15M13 6l6 6-6 6"/>',
  external: '<path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6L6 18"/>',
  chevron: '<path d="M6 9l6 6 6-6"/>',
  chat: '<path d="M4 5h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H10l-5 4v-4H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z"/>',
  check: '<path d="M5 12.5l4.5 4.5L19 7.5"/>',
  mail: '<path d="M3 6h18v12H3zM3 7l9 7 9-7"/>',
  book: '<path d="M12 7c-1.6-1.3-3.9-1.9-8-1.7v12.4c4.1-.2 6.4.4 8 1.7 1.6-1.3 3.9-1.9 8-1.7V5.3c-4.1-.2-6.4.4-8 1.7zM12 7v12.4"/>',
  sprout: '<path d="M12 20v-8M12 13c0-4 2.8-6.5 7-6.5 0 4-2.6 6.5-7 6.5zM12 16c0-3-2.1-5-5.5-5 0 3 2 5 5.5 5z"/>',
  globe: '<circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.4 2.4 3.6 5.2 3.6 8.5s-1.2 6.1-3.6 8.5c-2.4-2.4-3.6-5.2-3.6-8.5S9.6 5.9 12 3.5z"/>',
  shield: '<path d="M12 3.5l7 2.6v5.4c0 4.2-2.9 7.6-7 9-4.1-1.4-7-4.8-7-9V6.1zM9 12l2.2 2.2 3.8-4"/>',
  waves: '<path d="M3 8.5c2.3 0 2.3-1.6 4.5-1.6s2.2 1.6 4.5 1.6 2.3-1.6 4.5-1.6 2.2 1.6 4.5 1.6M3 13.5c2.3 0 2.3-1.6 4.5-1.6s2.2 1.6 4.5 1.6 2.3-1.6 4.5-1.6 2.2 1.6 4.5 1.6M3 18.5c2.3 0 2.3-1.6 4.5-1.6s2.2 1.6 4.5 1.6 2.3-1.6 4.5-1.6 2.2 1.6 4.5 1.6"/>',
