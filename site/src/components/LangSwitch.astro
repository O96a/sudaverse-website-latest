---
import { localeMeta, otherLocale, type Locale } from '@/i18n/config';
import { localePath, stripLocale } from '@/i18n/utils';

interface Props {
  locale: Locale;
  /** Compact label for small screens. */
  short?: boolean;
  class?: string;
}
const { locale, short = false, class: className } = Astro.props;
const other = otherLocale(locale);
const rest = stripLocale(Astro.url.pathname);
// The 404 page exists once, at the site root: switch language by going to the other home page.
const href = localePath(other, rest === '404' || rest === '404.html' ? '' : rest);
const label = short ? localeMeta[other].short : localeMeta[other].label;
---

<a class:list={['lang', className]} href={href} hreflang={other} lang={other} data-lang-switch>{label}</a>

<style>
  .lang {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    padding-inline: 0.75rem;
    color: var(--color-text-muted);
    font-size: var(--fs-200);
    font-weight: 560;
    text-decoration: none;
    border-radius: var(--radius-2);
  }
  .lang:hover {
    color: var(--ink);
    background: var(--paper-2);
  }
</style>
