---
import type { Locale } from '@/i18n/config';
import type { Stage } from '@/data/products';
import { t } from '@/i18n/utils';

interface Props {
  stage: Stage;
  locale: Locale;
}
const { stage, locale } = Astro.props;
const label = t(locale, `stage.${stage}` as const);
---

<span class={`stage stage--${stage}`}>{label}</span>

<style>
  .stage {
    display: inline-flex;
    align-items: center;
    block-size: 1.625rem;
    padding-inline: 0.65rem;
    border-radius: var(--radius-pill);
    font-size: var(--fs-100);
    font-weight: 650;
    line-height: 1.3;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  .stage--live {
    background: var(--color-stage-live-bg);
    color: var(--color-stage-live);
  }
  .stage--beta,
  .stage--pilot,
  .stage--development {
    background: var(--color-stage-dev-bg);
    color: var(--color-stage-dev);
  }
  .stage--research {
    background: var(--color-stage-research-bg);
    color: var(--color-stage-research);
  }
</style>
