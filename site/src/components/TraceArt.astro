---
/**
 * Generative circuit-trace art in the brand's own line language (the baobab's circuit trunk and
 * its square "leaves"): orthogonal traces with chamfered corners, hollow pads, hollow squares.
 * Deterministic from `seed`, so each product gets its own composition. Pure geometry: no
 * gradients, no glow, no fake UI. One copper "live thread" per figure when `thread` is set.
 */
interface Props {
  seed?: number;
  /** Colour family for traces and leaves. */
  tone?: 'nile' | 'sage' | 'deep';
  /** Number of traces. */
  traces?: number;
  /** Number of hollow squares. */
  leaves?: number;
  /** Draw a fine survey graticule underneath. */
  graticule?: boolean;
  /** Highlight one trace in copper and pulse it (respects reduced motion). */
  thread?: boolean;
  class?: string;
}
const { seed = 7, tone = 'nile', traces = 9, leaves = 14, graticule = false, thread = false, class: className } = Astro.props;

function rng(s: number) {
  let a = s >>> 0;
  return () => {
    a = (a + 0x6d2b79f5) | 0;
    let t = Math.imul(a ^ (a >>> 15), 1 | a);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}
const r = rng(seed);
const W = 800;
const H = 520;
const P = 40;
const cols = W / P;
const rows = H / P;

type Pt = [number, number];
function chamfer(pts: Pt[], c = 12): string {
  if (pts.length < 3) return `M${pts.map((p) => p.join(' ')).join(' L')}`;
  let d = `M${pts[0][0]} ${pts[0][1]}`;
  for (let i = 1; i < pts.length - 1; i++) {
    const [px, py] = pts[i - 1];
    const [x, y] = pts[i];
    const [nx, ny] = pts[i + 1];
    const v1: Pt = [Math.sign(x - px), Math.sign(y - py)];
    const v2: Pt = [Math.sign(nx - x), Math.sign(ny - y)];
    d += ` L${x - v1[0] * c} ${y - v1[1] * c} L${x + v2[0] * c} ${y + v2[1] * c}`;
  }
  const last = pts[pts.length - 1];
  return `${d} L${last[0]} ${last[1]}`;
}

const paths: { d: string; end: Pt; len: number }[] = [];
for (let i = 0; i < traces; i++) {
  let x = Math.floor(r() * (cols - 1)) * P + P;
  let y = Math.floor(r() * (rows - 1)) * P + P;
  let dir: Pt = r() < 0.5 ? [1, 0] : [0, 1];
  if (r() < 0.5) dir = [-dir[0], -dir[1]];
  const pts: Pt[] = [[x, y]];
  const segs = 3 + Math.floor(r() * 3);
  let len = 0;
  for (let s = 0; s < segs; s++) {
    const cells = 2 + Math.floor(r() * 4);
    const nx = Math.min(W - P, Math.max(P, x + dir[0] * cells * P));
    const ny = Math.min(H - P, Math.max(P, y + dir[1] * cells * P));
    if (nx === x && ny === y) break;
    len += Math.abs(nx - x) + Math.abs(ny - y);
    x = nx;
    y = ny;
    pts.push([x, y]);
    dir = r() < 0.5 ? [-dir[1], dir[0]] : [dir[1], -dir[0]];
  }
  if (pts.length > 2) paths.push({ d: chamfer(pts), end: pts[pts.length - 1], len });
}
const live = thread && paths.length ? paths.reduce((a, b) => (b.len > a.len ? b : a)) : null;

const sizes = [10, 14, 20, 28, 38];
const squares = Array.from({ length: leaves }, () => {
  const size = sizes[Math.floor(r() * sizes.length)];
  return {
    x: Math.round(r() * (W - 80) + 40),
    y: Math.round(r() * (H - 80) + 40),
    size,
    rot: r() < 0.45 ? 45 : 0,
    hue: r() < 0.5 ? 'a' : 'b',
  };
});
---

<svg
  class:list={['trace', `trace--${tone}`, className]}
  viewBox={`0 0 ${W} ${H}`}
  preserveAspectRatio="xMidYMid slice"
  aria-hidden="true"
  focusable="false"
>
  {
    graticule && (
      <g class="grat">
        {Array.from({ length: cols + 1 }, (_, i) => <line x1={i * P} y1="0" x2={i * P} y2={H} />)}
        {Array.from({ length: rows + 1 }, (_, i) => <line x1="0" y1={i * P} x2={W} y2={i * P} />)}
      </g>
    )
  }
  <g class="traces">
    {paths.map((p) => <path d={p.d} class={p === live ? 'is-thread' : ''} />)}
  </g>
  <g class="pads">
    {paths.map((p) => <circle cx={p.end[0]} cy={p.end[1]} r="6" class={p === live ? 'is-thread' : ''} />)}
  </g>
  <g class="leaves">
    {
      squares.map((s) => (
        <rect
          class={`leaf leaf--${s.hue}`}
          x={s.x - s.size / 2}
          y={s.y - s.size / 2}
          width={s.size}
          height={s.size}
          transform={s.rot ? `rotate(${s.rot} ${s.x} ${s.y})` : undefined}
        />
      ))
    }
  </g>
  {
    live && (
      <circle class="pulse" r="5">
        <animateMotion dur="6s" repeatCount="indefinite" path={live.d} />
      </circle>
    )
  }
</svg>

<style>
  .trace {
    inline-size: 100%;
    block-size: 100%;
    --t-trace: var(--nile-800);
    --t-leaf-a: var(--nile-700);
    --t-leaf-b: var(--sage-600);
    --t-pad-fill: var(--paper);
    --t-grat: color-mix(in srgb, var(--nile-800) 14%, transparent);
    --t-thread: var(--color-accent-thread);
  }
  .trace--sage {
    --t-trace: var(--sage-800);
    --t-leaf-a: var(--sage-600);
    --t-leaf-b: var(--nile-700);
  }
  .trace--deep {
    --t-trace: var(--nile-200);
    --t-leaf-a: var(--nile-200);
    --t-leaf-b: var(--sage-100);
    --t-pad-fill: var(--nile-900);
    --t-grat: color-mix(in srgb, var(--nile-200) 16%, transparent);
    --t-thread: var(--color-accent-thread-on-deep);
  }
  .grat line {
    stroke: var(--t-grat);
    stroke-width: 1;
  }
  .traces path {
    fill: none;
    stroke: var(--t-trace);
    stroke-width: 3;
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .pads circle {
    fill: var(--t-pad-fill);
    stroke: var(--t-trace);
    stroke-width: 3;
  }
  .leaf {
    fill: none;
    stroke-width: 3;
  }
  .leaf--a {
    stroke: var(--t-leaf-a);
  }
  .leaf--b {
    stroke: var(--t-leaf-b);
  }
  .traces path.is-thread,
  .pads circle.is-thread {
    stroke: var(--t-thread);
    stroke-width: 4;
  }
  .pulse {
    fill: var(--t-thread);
  }
  @media (prefers-reduced-motion: reduce) {
    .pulse {
      display: none;
    }
  }
</style>
