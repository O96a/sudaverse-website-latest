---
/**
 * An image or other media with a caption. Put an <Image> or <img> inside; the caption is required.
 * <Figure caption="..."><img src="..." alt="..." /></Figure>
 */
interface Props {
  caption: string;
}
const { caption } = Astro.props;
---

<figure class="fig">
  <slot />
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .fig {
    margin-block: var(--s-7);
  }
  .fig :global(img) {
    inline-size: 100%;
    block-size: auto;
    border-radius: var(--radius-1);
    border: 1px solid var(--color-border);
  }
  .fig figcaption {
    margin-block-start: var(--s-2);
    font-size: var(--fs-100);
    color: var(--color-text-meta);
  }
</style>
