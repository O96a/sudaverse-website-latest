---
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import { site } from '@/config/site';
import { products } from '@/data/products';
import { t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';
import { topicKeys, topicLabelKey } from './topics';

/**
 * The contact form. Works without JavaScript (native validation, mailto or endpoint `action`);
 * `src/scripts/contact-form.ts` upgrades it with inline validation and submission.
 */
interface Props {
  locale: Locale;
  headingId: string;
}
const { locale, headingId } = Astro.props;

const copy = {
  en: {
    intro: 'All fields are required except organization.',
    hintOrganization: 'Optional.',
    hintEmail: 'We will reply to this address.',
    hintMessage: 'What you are building, who it is for, and any timeline you are working to.',
    topicPlaceholder: 'Select a topic',
    prefillProduct: 'I would like to talk about {product}.',
    fallback: 'Prefer to write directly? Email',
  },
  ar: {
    intro: 'جميع الحقول مطلوبة عدا الجهة.',
    hintOrganization: 'اختياري.',
    hintEmail: 'سنردّ على هذا العنوان.',
    hintMessage: 'ما الذي تبنيه، ولمن هو، وأي جدول زمني تعمل عليه.',
    topicPlaceholder: 'اختر موضوعًا',
    prefillProduct: 'أودّ التحدث معكم بخصوص {product}.',
    fallback: 'تفضّل المراسلة المباشرة؟ راسلنا على',
  },
}[locale];

const endpoint = site.contact.formEndpoint;
const email = site.contact.email;

const config = {
  endpoint,
  email,
  locale,
  products: Object.fromEntries(products.map((p) => [p.slug, p.name])),
  topics: Object.fromEntries(topicKeys.map((k) => [k, t(locale, topicLabelKey(k))])),
  text: {
    required: t(locale, 'contact.required'),
    invalidEmail: t(locale, 'contact.invalidEmail'),
    send: t(locale, 'contact.send'),
    sending: t(locale, 'contact.sending'),
    sent: t(locale, 'contact.sent'),
    mailto: t(locale, 'contact.mailto'),
    error: t(locale, 'contact.error'),
    prefillProduct: copy.prefillProduct,
    labels: {
      name: t(locale, 'contact.name'),
      organization: t(locale, 'contact.organization'),
      email: t(locale, 'contact.email'),
    },
  },
};

// Without JavaScript the form posts natively: to the endpoint when there is one, otherwise as an email.
const nativeAction = endpoint
  ? { action: endpoint, method: 'post' }
  : { action: `mailto:${email}`, method: 'post', enctype: 'text/plain' };

const describedBy = (id: string, hint?: string) => [hint ? `${id}-hint` : '', `${id}-error`].filter(Boolean).join(' ');
---

<form
  class="form"
  data-contact-form
  data-config={JSON.stringify(config)}
  aria-labelledby={headingId}
  {...nativeAction}
>
  <p class="form__intro t-small t-muted">{copy.intro}</p>

  <div class="form__grid">
    <div class="field">
      <label for="cf-name">{t(locale, 'contact.name')}</label>
      <input id="cf-name" name="name" type="text" autocomplete="name" required aria-describedby={describedBy('cf-name')} />
      <p class="field__error" id="cf-name-error" aria-live="polite"></p>
    </div>

    <div class="field">
      <label for="cf-organization">{t(locale, 'contact.organization')}</label>
      <input
        id="cf-organization"
        name="organization"
        type="text"
        autocomplete="organization"
        aria-describedby={describedBy('cf-organization', copy.hintOrganization)}
      />
      <p class="field__hint" id="cf-organization-hint">{copy.hintOrganization}</p>
      <p class="field__error" id="cf-organization-error" aria-live="polite"></p>
    </div>

    <div class="field">
      <label for="cf-email">{t(locale, 'contact.email')}</label>
      <input
        id="cf-email"
        name="email"
        type="email"
        dir="ltr"
        autocomplete="email"
        inputmode="email"
        autocapitalize="off"
        spellcheck="false"
        required
        aria-describedby={describedBy('cf-email', copy.hintEmail)}
      />
      <p class="field__hint" id="cf-email-hint">{copy.hintEmail}</p>
      <p class="field__error" id="cf-email-error" aria-live="polite"></p>
    </div>

    <div class="field">
      <label for="cf-topic">{t(locale, 'contact.topic')}</label>
      <div class="select">
        <select id="cf-topic" name="topic" required aria-describedby={describedBy('cf-topic')}>
          <option value="">{copy.topicPlaceholder}</option>
          {topicKeys.map((key) => <option value={key}>{t(locale, topicLabelKey(key))}</option>)}
        </select>
        <Icon name="chevron" size={18} class="select__chev" />
      </div>
      <p class="field__error" id="cf-topic-error" aria-live="polite"></p>
    </div>

    <div class="field field--wide">
      <label for="cf-message">{t(locale, 'contact.message')}</label>
      <textarea
        id="cf-message"
        name="message"
        rows="7"
        required
        aria-describedby={describedBy('cf-message', copy.hintMessage)}
      ></textarea>
      <p class="field__hint" id="cf-message-hint">{copy.hintMessage}</p>
      <p class="field__error" id="cf-message-error" aria-live="polite"></p>
    </div>

    <!-- Spam trap: hidden from people and assistive technology; bots tend to fill it in. -->
    <div class="trap" aria-hidden="true">
      <label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
    </div>
  </div>

  <div class="form__actions">
    <Button type="submit" variant="primary" data-submit>
      <span data-submit-label>{t(locale, 'contact.send')}</span>
    </Button>
    <div class="status" data-status role="status" aria-live="polite"></div>
  </div>

  <p class="form__fallback t-small t-muted">
    {copy.fallback}{' '}<a href={`mailto:${email}`} dir="ltr">{email}</a>
  </p>
</form>

<style>
  .form {
    display: grid;
    gap: var(--s-5);
  }
  .form__intro {
    max-inline-size: none;
  }
  .form__grid {
    display: grid;
    gap: var(--s-5);
    align-items: start;
  }
  @media (min-width: 40rem) {
    .form__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--s-5);
    }
    .field--wide {
      grid-column: 1 / -1;
    }
  }

  .field {
    display: grid;
    gap: var(--s-2);
    align-content: start;
  }
  .field label {
    font-size: var(--fs-200);
    font-weight: 620;
    line-height: 1.3;
  }
  .field input,
  .field select,
  .field textarea {
    inline-size: 100%;
    min-block-size: 3rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-2);
    background: var(--white);
    color: var(--color-text);
    font-size: var(--fs-300);
    line-height: 1.4;
    transition: border-color var(--dur-1) var(--ease-out);
  }
  .field textarea {
    min-block-size: 10rem;
    resize: vertical;
    line-height: var(--lh-body);
  }
  .field input:hover,
  .field select:hover,
  .field textarea:hover {
    border-color: var(--ink-3);
  }
  .field input:focus-visible,
  .field select:focus-visible,
  .field textarea:focus-visible {
    border-color: var(--color-focus);
    outline-offset: 1px;
    border-radius: var(--radius-2);
  }
  .field [aria-invalid='true'] {
    border-color: var(--color-error);
  }

  .select {
    position: relative;
  }
  .select select {
    appearance: none;
    padding-inline-end: 2.75rem;
    cursor: pointer;
  }
  .select :global(.select__chev) {
    position: absolute;
    inset-inline-end: 0.9rem;
    inset-block-start: 50%;
    translate: 0 -50%;
    color: var(--color-text-muted);
    pointer-events: none;
  }

  .field__hint {
    font-size: var(--fs-100);
    line-height: 1.4;
    color: var(--color-text-meta);
    max-inline-size: none;
  }
  .field__error {
    font-size: var(--fs-200);
    line-height: 1.4;
    font-weight: 560;
    color: var(--color-error);
    max-inline-size: none;
  }

  /* Hidden from sight and from assistive technology; not display:none so simple bots still see it. */
  .trap {
    position: absolute;
    inline-size: 1px;
    block-size: 1px;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    opacity: 0;
  }

  .form__actions {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
  }
  .form__actions :global([data-submit][aria-disabled='true']) {
    opacity: 0.7;
    cursor: progress;
  }
  .status {
    max-inline-size: 44ch;
    font-size: var(--fs-200);
    line-height: 1.5;
  }
  .status:empty {
    display: block;
    padding: 0;
  }
  .status:not(:empty) {
    padding: var(--s-3) var(--s-4);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-2);
    background: var(--paper-2);
    color: var(--color-text);
  }
  .status[data-kind='success']:not(:empty) {
    border-color: var(--sage-700);
    background: var(--sage-100);
    color: var(--sage-800);
  }
  .status[data-kind='error']:not(:empty) {
    border-color: var(--color-error);
    background: var(--white);
    color: var(--color-error);
  }
  .status :global(a) {
    color: inherit;
    font-weight: 620;
  }

  .form__fallback {
    max-inline-size: none;
  }
</style>

<script>
  import '../../scripts/contact-form';
</script>
