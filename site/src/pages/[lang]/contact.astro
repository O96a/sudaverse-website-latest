---
import { Picture } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import heroArt from '@/assets/photos/contact-hero.jpg';
import ContactForm from '@/components/contact/ContactForm.astro';
import DirectContact from '@/components/contact/DirectContact.astro';
import Crumbs from '@/components/docs/Crumbs.astro';
import { site } from '@/config/site';
import { localePath, localeStaticPaths, t } from '@/i18n/utils';
import type { Locale } from '@/i18n/config';

export function getStaticPaths() {
  return localeStaticPaths();
}
const locale = Astro.params.lang as Locale;

const copy = {
  en: {
    title: 'Talk to Us',
    description:
      'Contact Sudaverse about a product inquiry, institutional partnership, research collaboration, data or model collaboration, or technical integration.',
    lead: 'Tell us about the product, partnership or project you have in mind. Your message goes to the Sudaverse team.',
    formH: 'Send a message',
  },
  ar: {
    title: 'تواصل معنا | سودافيرس',
    description:
      'تواصل مع سودافيرس بشأن استفسار عن منتج، أو شراكة مؤسسية، أو تعاون بحثي، أو تعاون في البيانات أو النماذج، أو تكامل تقني.',
    lead: 'أخبرنا عن المنتج أو الشراكة أو المشروع الذي تفكر فيه. تصل رسالتك إلى فريق سودافيرس.',
    formH: 'أرسل رسالة',
  },
}[locale];

const pageUrl = new URL(localePath(locale, 'contact'), site.origin).toString();
const homeUrl = new URL(localePath(locale), site.origin).toString();

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t(locale, 'misc.home'), item: homeUrl },
      { '@type': 'ListItem', position: 2, name: t(locale, 'contact.title'), item: pageUrl },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: t(locale, 'contact.title'),
    url: pageUrl,
    inLanguage: locale,
  },
];
---

<Base title={copy.title} description={copy.description} nav="contact" jsonLd={jsonLd} noChat>
  <section class="page" aria-labelledby="contact-h">
    <div class="container">
      <Crumbs locale={locale} items={[{ label: t(locale, 'contact.title') }]} />
      <header class="page__head">
        <div class="page__text">
          <h1 id="contact-h">{t(locale, 'contact.title')}</h1>
          <p class="t-lead">{copy.lead}</p>
        </div>
        <div class="page__art" aria-hidden="true">
          <Picture
            src={heroArt}
            formats={['avif', 'webp']}
            widths={[480, 800, 1200]}
            sizes="(min-width: 64rem) 46vw, 92vw"
            alt=""
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </header>

      <div class="layout">
        <section class="layout__form" aria-labelledby="form-h">
          <h2 id="form-h" class="layout__h">{copy.formH}</h2>
          <ContactForm locale={locale} headingId="form-h" />
        </section>
        <aside class="layout__direct" aria-labelledby="direct-h">
          <DirectContact locale={locale} />
        </aside>
      </div>
    </div>
  </section>
</Base>

<style>
  .page {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: var(--s-4) var(--section-y);
  }
  .page__head {
    display: grid;
    gap: var(--s-5);
    align-items: center;
    padding-block: var(--s-6) var(--s-7);
  }
  .page__text {
    display: grid;
    gap: var(--s-4);
    align-content: center;
  }
  .page__head h1 {
    max-inline-size: 12ch;
  }
  /* The picture is mostly white: multiply lets the page colour show through, so it has no box edge. */
  .page__art {
    min-inline-size: 0;
    max-inline-size: 42rem;
  }
  .page__art :global(img) {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    mix-blend-mode: multiply;
    -webkit-mask-image: linear-gradient(to bottom, transparent, #000 8%, #000 80%, transparent),
      linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to bottom, transparent, #000 8%, #000 80%, transparent),
      linear-gradient(to right, transparent, #000 7%, #000 93%, transparent);
    mask-composite: intersect;
  }
  @media (min-width: 64rem) {
    .page__head {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--s-8);
      padding-block: var(--s-4) var(--s-8);
    }
    .page__art {
      max-inline-size: none;
    }
  }
  .layout {
    display: grid;
    gap: var(--s-8);
    align-items: start;
  }
  .layout__h {
    font-size: var(--fs-500);
    margin-block-end: var(--s-5);
  }
  .layout__form {
    min-inline-size: 0;
    padding-block-start: var(--s-5);
    border-block-start: 1px solid var(--color-border-strong);
  }
  .layout__direct {
    min-inline-size: 0;
    padding-block-start: var(--s-5);
    border-block-start: 1px solid var(--color-border-strong);
  }
  @media (min-width: 64rem) {
    .layout {
      grid-template-columns: minmax(0, 7fr) minmax(0, 4fr);
      gap: var(--s-9);
    }
  }
</style>
