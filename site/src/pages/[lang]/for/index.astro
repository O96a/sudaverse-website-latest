---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import Crumbs from '@/components/docs/Crumbs.astro';
import CtaBand from '@/components/products/CtaBand.astro';
import { audiences } from '@/data/audiences';
import { site } from '@/config/site';
import { localePath, localeStaticPaths, t } from '@/i18n/utils';
import { pick, type Locale } from '@/i18n/config';

export function getStaticPaths() {
  return localeStaticPaths();
}
const locale = Astro.params.lang as Locale;
const L = (v: Parameters<typeof pick>[0]) => (pick(v as never, locale) as string | undefined) ?? '';

const copy = {
  en: {
    title: 'Who we serve | Sudaverse',
    description:
      'Sudaverse builds AI products and digital infrastructure for companies, large organizations, public institutions, NGOs, academic institutions and developers.',
    h1: 'Who we serve',
    lead: 'Sudaverse builds AI products and digital infrastructure for organizations of different sizes and kinds. Choose the one closest to you.',
    open: 'Read more',
    cta: { h2: 'Not sure which fits?', body: 'Tell us what you are working on. Your message goes to the Sudaverse team.' },
  },
  ar: {
    title: 'من نخدم | سودافيرس',
    description:
      'تبني سودافيرس منتجات ذكاء اصطناعي وبنية رقمية للشركات والمؤسسات الكبرى والمؤسسات العامة والمنظمات غير الحكومية والمؤسسات الأكاديمية والمطورين.',
    h1: 'من نخدم',
    lead: 'تبني سودافيرس منتجات ذكاء اصطناعي وبنية رقمية لمؤسسات مختلفة الأحجام والأنواع. اختر الأقرب إليك.',
    open: 'اقرأ المزيد',
    cta: { h2: 'لست متأكدًا من الأنسب؟', body: 'أخبرنا بما تعمل عليه. تصل رسالتك إلى فريق سودافيرس.' },
  },
}[locale];

const abs = (p: string) => new URL(p, site.origin).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t(locale, 'misc.home'), item: abs(localePath(locale)) },
      { '@type': 'ListItem', position: 2, name: copy.h1, item: abs(localePath(locale, 'for')) },
    ],
  },
];
---

<Base title={copy.title} description={copy.description} nav="audience" jsonLd={jsonLd}>
  <div class="container">
    <Crumbs locale={locale} items={[{ label: copy.h1 }]} />
    <header class="head">
      <h1 id="aud-h">{copy.h1}</h1>
      <p class="t-lead">{copy.lead}</p>
    </header>
  </div>

  <section class="section section--tight" aria-label={copy.h1}>
    <div class="container">
      <ul role="list" class="list">
        {
          audiences.map((a) => (
            <li>
              <a class="row" href={localePath(locale, `for/${a.slug}`)}>
                <span class="row__icon" aria-hidden="true"><Icon name={a.icon} size={26} /></span>
                <span class="row__text">
                  <span class="row__name">{L(a.name)}</span>
                  <span class="row__short">{L(a.short)}</span>
                </span>
                <span class="row__go"><span class="sr-only">{copy.open}: {L(a.name)}</span><Icon name="arrow" size={22} directional /></span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand
    id="aud-index-cta"
    heading={copy.cta.h2}
    body={copy.cta.body}
    primary={{ href: localePath(locale, 'contact'), label: t(locale, 'cta.talk') }}
    secondary={{ href: localePath(locale, 'solutions'), label: t(locale, 'cta.seeAllSolutions') }}
    seed={21}
  />
</Base>

<style>
  .head {
    display: grid;
    gap: var(--s-5);
    padding-block: var(--s-6) var(--s-7);
    justify-items: start;
  }
  .head h1 {
    max-inline-size: 14ch;
  }
  .list {
    margin: 0;
    padding: 0;
    border-block-start: 1px solid var(--color-border-strong);
  }
  .row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: var(--s-5);
    align-items: center;
    padding-block: var(--s-5);
    border-block-end: 1px solid var(--color-border);
    color: var(--ink);
    text-decoration: none;
  }
  .row:hover {
    background: color-mix(in srgb, var(--brand-blue) 8%, transparent);
    color: var(--ink);
  }
  .row__icon {
    display: grid;
    place-items: center;
    inline-size: 3.25rem;
    block-size: 3.25rem;
    border-radius: 10px;
    background: color-mix(in srgb, var(--brand-blue) 14%, var(--white));
    color: var(--brand-blue-700);
  }
  .row__text {
    display: grid;
    gap: 0.2rem;
  }
  .row__name {
    font-size: var(--fs-500);
    font-weight: 650;
    line-height: var(--lh-snug);
  }
  .row__short {
    color: var(--color-text-muted);
  }
  .row__go {
    color: var(--nile-700);
  }
</style>
