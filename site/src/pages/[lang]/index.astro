---
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import HeroStage from '@/components/hero/HeroStage.astro';
import TraceArt from '@/components/TraceArt.astro';
import { offerings } from '@/data/services';
import { team } from '@/data/team';
import { localePath, localeStaticPaths, t } from '@/i18n/utils';
import { pick, type Locale } from '@/i18n/config';

export function getStaticPaths() {
  return localeStaticPaths();
}
const locale = Astro.params.lang as Locale;
const L = (v: Parameters<typeof pick>[0]) => (pick(v as never, locale) as string | undefined) ?? '';

/*
 * The home page is the corporate front door (owner direction, 2026-09-26): services, sectors, values and
 * how we work. Products and projects live under Projects in the header, not here.
 */
const copy = {
  en: {
    title: 'Sudaverse | AI, data and cybersecurity services for Sudan',
    description:
      'Sudaverse is a Sudanese technology company providing AI adoption, cybersecurity, infrastructure, data and training services across healthcare, agriculture, education, geospatial intelligence and more.',
    hero: {
      h1: ['Applied AI and digital systems, ', 'built for Sudan', '.'],
      lead: 'Sudaverse helps institutions and companies adopt AI, protect their systems and build reliable digital infrastructure, across healthcare, agriculture, education, geospatial intelligence and more.',
      services: 'Explore our services',
      about: 'About Sudaverse',
    },
    services: {
      h2: 'What we do',
      lead: 'From infrastructure to applied AI, Sudaverse works with institutions and companies along the whole path. Every engagement starts with a conversation about the problem.',
      cta: 'Discuss your needs',
    },
    sectors: {
      h2: 'Sectors we serve',
      lead: 'One engineering team works across sectors, so what we learn in one carries into the next. Every engagement is shaped around the sector’s own data, rules and people.',
      items: [
        { t: 'Healthcare', d: 'Health information systems, AI-assisted workflows and secure handling of sensitive records.' },
        { t: 'Agriculture', d: 'Crop and field data, advisory tools and Arabic-language access to agricultural knowledge.' },
        { t: 'Education', d: 'Learning tools that follow local curricula, and data systems for schools and universities.' },
        { t: 'Geospatial intelligence', d: 'Maps, satellite imagery and location data turned into monitoring and decision support.' },
        { t: 'Public institutions and NGOs', d: 'Digital infrastructure, data systems and security for organizations that serve the public.' },
        { t: 'Private sector', d: 'AI adoption, cybersecurity and data engineering for companies of every size.' },
      ],
    },
    values: {
      h2: 'What we stand for',
      lead: 'The principles behind every engagement, whatever the sector.',
      items: [
        { t: 'Local capability', d: 'We build national capability through Sudanese expertise, and we leave your team able to run what we deliver.' },
        { t: 'Security by design', d: 'Data, models and infrastructure are protected from the first design decision, not patched afterwards.' },
        { t: 'Ethical AI', d: 'Bias, fairness and privacy are engineering concerns. We evaluate what we build for the contexts it serves.' },
        { t: 'Cultural integrity', d: 'Local language, context and heritage are design inputs, not afterthoughts.' },
        { t: 'Plain advice', d: 'We tell you plainly whether we can help, and what a problem really needs before money is spent.' },
        { t: 'Open collaboration', d: 'We publish tools and research openly, and we welcome researchers and institutions who want to build with us.' },
      ],
    },
    approach: {
      h2: 'How we work',
      lead: 'A clear path from the first conversation to a system your team owns.',
      steps: [
        { t: 'Understand', d: 'Every engagement starts with a conversation about the problem, the people involved and the constraints.' },
        { t: 'Plan', d: 'We recommend an architecture and technology choices before anything is bought or built.' },
        { t: 'Build and secure', d: 'We deliver inside your environment, cloud or on-premises, tested, secured and documented.' },
        { t: 'Hand over', d: 'Training and documentation leave your team confident to run and extend what we built.' },
      ],
    },
    about: {
      label: 'Sudaverse at a glance',
      lead: 'Sudanese-founded. Globally connected. Building technology around local realities.',
      detail: (n: number) =>
        `A team of ${n} Sudanese engineers and researchers across machine learning, software engineering, cybersecurity, applied research and consulting.`,
      h2: 'Local context, engineering depth, applied research.',
      points: ['Arabic-first AI', 'Local and private deployment options', 'Applied AI engineering', 'Domain-specific systems', 'Research-driven development'],
    },
    cta: {
      h2: 'Build with Sudaverse.',
      body: 'Working on a problem involving AI, data, cybersecurity, education, agriculture, digital health or digital infrastructure? Talk with our engineering team.',
      about: 'About Sudaverse',
    },
  },
  ar: {
    title: 'سودافيرس | خدمات الذكاء الاصطناعي والبيانات والأمن السيبراني للسودان',
    description:
      'سودافيرس شركة تقنية سودانية تقدّم خدمات تبنّي الذكاء الاصطناعي والأمن السيبراني والبنية التحتية والبيانات والتدريب في الرعاية الصحية والزراعة والتعليم والمعلومات الجغرافية وغيرها.',
    hero: {
      h1: ['ذكاء اصطناعي تطبيقي وأنظمة رقمية، ', 'مبنية للسودان', '.'],
      lead: 'تساعد سودافيرس المؤسسات والشركات على تبنّي الذكاء الاصطناعي وحماية أنظمتها وبناء بنية رقمية موثوقة، في الرعاية الصحية والزراعة والتعليم والمعلومات الجغرافية وغيرها.',
      services: 'استكشف خدماتنا',
      about: 'عن سودافيرس',
    },
    services: {
      h2: 'ما نقدّمه',
      lead: 'من البنية التحتية إلى الذكاء الاصطناعي التطبيقي، تعمل سودافيرس مع المؤسسات والشركات على امتداد الطريق كله. ويبدأ كل تعاون بحديث عن المشكلة.',
      cta: 'ناقش احتياجاتك',
    },
    sectors: {
      h2: 'القطاعات التي نخدمها',
      lead: 'يعمل فريق هندسي واحد عبر القطاعات، فتنتقل خبرة كل قطاع إلى الآخر. ويُصمَّم كل تعاون حول بيانات القطاع وأنظمته والعاملين فيه.',
      items: [
        { t: 'الرعاية الصحية', d: 'أنظمة المعلومات الصحية وسير العمل المدعوم بالذكاء الاصطناعي والتعامل الآمن مع السجلات الحساسة.' },
        { t: 'الزراعة', d: 'بيانات المحاصيل والحقول وأدوات الإرشاد، والوصول إلى المعرفة الزراعية باللغة العربية.' },
        { t: 'التعليم', d: 'أدوات تعلّم تتبع المناهج المحلية، وأنظمة بيانات للمدارس والجامعات.' },
        { t: 'المعلومات الجغرافية', d: 'تحويل الخرائط وصور الأقمار الصناعية وبيانات المواقع إلى مراقبة ودعم للقرار.' },
        { t: 'المؤسسات العامة والمنظمات', d: 'بنية رقمية وأنظمة بيانات وحماية أمنية للجهات التي تخدم الناس.' },
        { t: 'القطاع الخاص', d: 'تبنّي الذكاء الاصطناعي والأمن السيبراني وهندسة البيانات للشركات بمختلف أحجامها.' },
      ],
    },
    values: {
      h2: 'ما نلتزم به',
      lead: 'المبادئ التي تحكم كل تعاون، أيًّا كان القطاع.',
      items: [
        { t: 'القدرات المحلية', d: 'نبني القدرات الوطنية بخبرات سودانية، ونترك فريقكم قادرًا على تشغيل ما نسلّمه.' },
        { t: 'الأمن منذ التصميم', d: 'نحمي البيانات والنماذج والبنية التحتية من أول قرار في التصميم، لا بالترقيع لاحقًا.' },
        { t: 'الذكاء الاصطناعي الأخلاقي', d: 'التحيز والعدالة والخصوصية شواغل هندسية. ونقيّم ما نبنيه بحسب السياقات التي يخدمها.' },
        { t: 'الأصالة الثقافية', d: 'اللغة والسياق والتراث المحلي مدخلات في التصميم وليست أفكارًا لاحقة.' },
        { t: 'مشورة واضحة', d: 'نخبركم بوضوح إن كان بوسعنا المساعدة، وبما تحتاجه المشكلة فعلًا قبل الإنفاق.' },
        { t: 'التعاون المفتوح', d: 'ننشر الأدوات والأبحاث علنًا، ونرحّب بالباحثين والمؤسسات الراغبين في البناء معنا.' },
      ],
    },
    approach: {
      h2: 'كيف نعمل',
      lead: 'طريق واضح من المحادثة الأولى إلى نظام يملكه فريقكم.',
      steps: [
        { t: 'الفهم', d: 'يبدأ كل تعاون بحديث عن المشكلة والأشخاص المعنيين والقيود.' },
        { t: 'التخطيط', d: 'نقترح المعمارية واختيارات التقنية قبل شراء أي شيء أو بنائه.' },
        { t: 'البناء والتأمين', d: 'نسلّم داخل بيئتكم، سحابية كانت أو محلية، بعد الاختبار والتأمين والتوثيق.' },
        { t: 'التسليم', d: 'يترك التدريب والتوثيق فريقكم واثقًا في تشغيل ما بنيناه وتوسيعه.' },
      ],
    },
    about: {
      label: 'سودافيرس بنظرة سريعة',
      lead: 'تأسست في السودان. متصلة بالعالم. تبني التقنية حول الواقع المحلي.',
      // Arabic counted nouns: 3 to 10 take the genitive plural, 11 and up the accusative singular.
      detail: (n: number) =>
        `فريق من ${n} ${n <= 10 ? 'مهندسين وباحثين سودانيين' : 'مهندسًا وباحثًا سودانيًا'} في تعلّم الآلة وهندسة البرمجيات والأمن السيبراني والبحث التطبيقي والاستشارات.`,
      h2: 'سياق محلي وعمق هندسي وبحث تطبيقي.',
      points: ['ذكاء اصطناعي عربي أولاً', 'خيارات نشر محلية وخاصة', 'هندسة ذكاء اصطناعي تطبيقي', 'أنظمة متخصصة بالمجال', 'تطوير مدفوع بالبحث'],
    },
    cta: {
      h2: 'ابنِ مع سودافيرس.',
      body: 'هل تعمل على مشكلة تتعلق بالذكاء الاصطناعي أو البيانات أو الأمن السيبراني أو التعليم أو الزراعة أو الصحة الرقمية أو البنية الرقمية؟ تحدّث مع فريقنا الهندسي.',
      about: 'عن سودافيرس',
    },
  },
}[locale];

const aboutHref = localePath(locale, 'about');
const contactHref = localePath(locale, 'contact');
const servicesHref = `${contactHref}?topic=services`;
---

<Base title={copy.title} description={copy.description} nav="home">
  <!-- 1. Hero: the sectors graph -->
  <section class="hero" aria-labelledby="hero-h">
    <div class="container hero__grid">
      <div class="hero__text">
        <h1 id="hero-h">{copy.hero.h1[0]}<span class="hero__accent">{copy.hero.h1[1]}</span>{copy.hero.h1[2]}</h1>
        <p class="t-lead hero__lead">{copy.hero.lead}</p>
        <div class="cluster hero__cta">
          <Button href="#services" variant="primary" arrow>{copy.hero.services}</Button>
          <Button href={contactHref} variant="secondary">{t(locale, 'cta.talkToSudaverse')}</Button>
        </div>
        <a class="textlink" href={aboutHref}>
          {copy.hero.about}
          <Icon name="arrow" size={18} directional />
        </a>
      </div>
      <div class="hero__stage">
        <HeroStage locale={locale} />
      </div>
    </div>
  </section>

  <!-- 2. Services -->
  <section class="svc" id="services" aria-labelledby="svc-h">
    <div class="container svc__grid">
      <div class="svc__head" data-reveal>
        <h2 id="svc-h">{copy.services.h2}</h2>
        <p class="t-lead">{copy.services.lead}</p>
        <Button href={servicesHref} variant="secondary" arrow>{copy.services.cta}</Button>
      </div>
      <ul role="list" class="svc__list" data-reveal>
        {
          offerings.map((o, i) => (
            <li>
              <a class="svc__row" href={`${servicesHref}&service=${o.id}`}>
                <span class="svc__icon" data-tone={i % 3}>
                  <Icon name={o.icon} size={22} />
                </span>
                <span class="svc__text">
                  <span class="svc__name">{L(o.name)}</span>
                  <span class="svc__sum">{L(o.summary)}</span>
                </span>
                <Icon name="arrow" size={18} directional class="svc__arrow" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 3. Sectors -->
  <section class="section sectors" id="sectors" aria-labelledby="sectors-h">
    <div class="container">
      <div class="head" data-reveal>
        <h2 id="sectors-h">{copy.sectors.h2}</h2>
        <p class="t-lead">{copy.sectors.lead}</p>
      </div>
      <dl class="sectors__list" data-reveal>
        {
          copy.sectors.items.map((s) => (
            <div class="sectors__row">
              <dt>{s.t}</dt>
              <dd>{s.d}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <!-- 4. Values -->
  <section class="section section--deep on-deep values" aria-labelledby="values-h">
    <div class="container">
      <div class="head" data-reveal>
        <h2 id="values-h">{copy.values.h2}</h2>
        <p class="t-lead values__lead">{copy.values.lead}</p>
      </div>
      <ul role="list" class="values__list" data-reveal>
        {
          copy.values.items.map((v) => (
            <li>
              <h3 class="values__t">{v.t}</h3>
              <p class="values__d">{v.d}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 5. How we work -->
  <section class="section approach" aria-labelledby="approach-h">
    <div class="container">
      <div class="head" data-reveal>
        <h2 id="approach-h">{copy.approach.h2}</h2>
        <p class="t-lead">{copy.approach.lead}</p>
      </div>
      <ol role="list" class="approach__list" data-reveal>
        {
          copy.approach.steps.map((s) => (
            <li>
              <span class="approach__node" aria-hidden="true" />
              <h3 class="approach__t">{s.t}</h3>
              <p class="approach__d">{s.d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- 6. Company statement and what sets the work apart -->
  <section class="about" aria-label={copy.about.label}>
    <div class="container about__grid">
      <div class="about__main">
        <p class="about__lead">{copy.about.lead}</p>
        <p class="about__detail">{copy.about.detail(team.length)}</p>
        <a class="textlink" href={`${aboutHref}#team`}>
          {t(locale, 'cta.meetTeam')}
          <Icon name="arrow" size={18} directional />
        </a>
      </div>
      <div class="about__pts">
        <h2 class="about__h">{copy.about.h2}</h2>
        <ul role="list" class="about__list">
          {copy.about.points.map((p) => <li>{p}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- 7. Final call to action -->
  <section class="section section--deep on-deep cta" aria-labelledby="cta-h">
    <div class="cta__art" aria-hidden="true"><TraceArt seed={5} tone="deep" traces={7} leaves={8} /></div>
    <div class="container cta__inner">
      <h2 id="cta-h">{copy.cta.h2}</h2>
      <p class="t-lead cta__body">{copy.cta.body}</p>
      <div class="cluster">
        <Button href={contactHref} variant="light" arrow>{t(locale, 'cta.talk')}</Button>
        <Button href={aboutHref} variant="outline-deep">{copy.cta.about}</Button>
      </div>
    </div>
  </section>
</Base>

<style>
  h2 {
    max-inline-size: 20ch;
  }
  .head {
    display: grid;
    gap: var(--s-4);
    margin-block-end: var(--s-7);
  }
  .head h2 {
    max-inline-size: 22ch;
  }
  .head__cta {
    margin-block-start: var(--s-7);
    max-inline-size: none;
  }
  .textlink {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 2.75rem;
    font-weight: 620;
    text-decoration: none;
  }
  .textlink:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  /* ---- Hero ---- */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2rem, 0.75rem + 4vw, 4.25rem) var(--section-y-tight);
  }
  .hero__grid {
    position: relative;
    display: grid;
    align-items: center;
    gap: var(--s-7);
  }
  .hero__text {
    display: grid;
    gap: var(--s-5);
    align-content: center;
    justify-items: start;
  }
  .hero h1 {
    font-size: clamp(2.25rem, 1.15rem + 3vw, 3.5rem);
    line-height: var(--lh-tight);
    max-inline-size: 17ch;
  }
  .hero__accent {
    color: var(--brand-blue-600);
  }
  .hero__lead {
    max-inline-size: 44ch;
  }
  .hero__cta {
    gap: var(--s-3);
  }
  @media (max-width: 39.99rem) {
    .hero__cta {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      inline-size: 100%;
    }
    .hero__cta :global(.btn) {
      justify-content: center;
    }
  }
  .hero__stage {
    min-inline-size: 0;
  }
  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--s-7);
    }
  }

  /* ---- Services ---- */
  .svc {
    padding-block: var(--section-y-tight);
    background: var(--color-bg-alt);
  }
  .svc__grid {
    display: grid;
    gap: var(--s-7);
  }
  .svc__head {
    display: grid;
    gap: var(--s-4);
    align-content: start;
    justify-items: start;
  }
  .svc__head h2 {
    max-inline-size: 14ch;
  }
  .svc__list {
    display: grid;
    margin: 0;
    padding: 0;
    border-block-start: 1px solid var(--color-border-strong);
  }
  .svc__row {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: start;
    gap: var(--s-4);
    block-size: 100%;
    padding-block: var(--s-5);
    padding-inline: var(--s-1);
    border-block-end: 1px solid var(--color-border-strong);
    color: var(--ink);
    text-decoration: none;
  }
  /* A copper hairline draws in along the row's lower edge on hover and focus. */
  .svc__row::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: -1px;
    block-size: 1px;
    background: var(--color-accent-thread);
    transform: scaleX(0);
    transform-origin: left;
  }
  [dir='rtl'] .svc__row::after {
    transform-origin: right;
  }
  .svc__row:hover::after,
  .svc__row:focus-visible::after {
    transform: scaleX(1);
  }
  @media (prefers-reduced-motion: no-preference) {
    .svc__row::after {
      transition: transform var(--dur-4) var(--ease-out);
    }
    .svc__row :global(.svc__arrow) {
      transition: translate var(--dur-3) var(--ease-out), color var(--dur-2) var(--ease-out);
    }
  }
  .svc__row:hover {
    color: var(--ink);
  }
  .svc__icon {
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border-radius: var(--radius-2);
    background: color-mix(in srgb, var(--brand-blue) 16%, var(--white));
    color: var(--brand-blue-700);
  }
  .svc__icon[data-tone='1'] {
    background: color-mix(in srgb, var(--brand-green) 18%, var(--white));
    color: var(--brand-green-700);
  }
  .svc__icon[data-tone='2'] {
    background: var(--nile-100);
    color: var(--nile-800);
  }
  .svc__text {
    display: grid;
    gap: var(--s-1);
    min-inline-size: 0;
  }
  .svc__name {
    font-size: var(--fs-400);
    font-weight: 650;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-h3);
  }
  .svc__sum {
    font-size: var(--fs-200);
    line-height: 1.55;
    color: var(--color-text-muted);
  }
  .svc__row :global(.svc__arrow) {
    margin-block-start: 0.35rem;
    color: var(--color-text-meta);
  }
  .svc__row:hover :global(.svc__arrow),
  .svc__row:focus-visible :global(.svc__arrow) {
    color: var(--copper-700);
    translate: 0.2rem 0;
  }
  [dir='rtl'] .svc__row:hover :global(.svc__arrow),
  [dir='rtl'] .svc__row:focus-visible :global(.svc__arrow) {
    translate: -0.2rem 0;
  }
  @media (min-width: 48rem) {
    .svc__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--s-7);
    }
  }
  @media (min-width: 64rem) {
    .svc__grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: var(--s-8);
    }
    .svc__head {
      position: sticky;
      inset-block-start: calc(var(--header-h) + var(--s-6));
    }
  }

  /* ---- Company statement and what sets the work apart ---- */
  .about {
    padding-block: var(--section-y-tight);
  }
  .about__grid {
    display: grid;
    gap: var(--s-6);
    padding-block-start: var(--s-6);
    border-block-start: 1px solid var(--color-border-strong);
  }
  .about__main {
    display: grid;
    gap: var(--s-4);
