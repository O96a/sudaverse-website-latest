---
import { Image } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import HeroStage from '@/components/hero/HeroStage.astro';
import TraceArt from '@/components/TraceArt.astro';
import ProductArt from '@/components/products/ProductArt.astro';
import ProductPitch from '@/components/ProductPitch.astro';
import StageBadge from '@/components/StageBadge.astro';
import PipelineFlow from '@/components/flow/PipelineFlow';
import { productBySlug, products } from '@/data/products';
import { artifactsFor } from '@/lib/artifacts';
import { offerings } from '@/data/services';
import { openWork, directions, publications } from '@/data/research';
import { team } from '@/data/team';
import { localePath, localeStaticPaths, t } from '@/i18n/utils';
import { pick, type Locale } from '@/i18n/config';

export function getStaticPaths() {
  return localeStaticPaths();
}
const locale = Astro.params.lang as Locale;
const L = (v: Parameters<typeof pick>[0]) => (pick(v as never, locale) as string | undefined) ?? '';

interface Counts {
  team: number;
  live: number;
  dev: number;
  repos: number;
}

const copy = {
  en: {
    title: 'Sudaverse | Applied AI and digital systems for Sudan',
    description:
      'Sudaverse builds Arabic and global AI products and digital platforms across education, agriculture, cybersecurity, geospatial monitoring and language technology.',
    hero: {
      h1: ['Applied AI for Sudan’s most ', 'important systems.', ''],
      lead: 'Sudaverse builds Arabic and global AI products and digital platforms across education, agriculture, cybersecurity, geospatial monitoring and language technology.',
    },
    about: {
      label: 'Sudaverse at a glance',
      detail: ({ team, live, dev, repos }: Counts) =>
        `A team of ${team} Sudanese engineers and researchers. ${live} products are live${dev > 0 ? `, ${dev} more are in development,` : ''} and ${repos} open-source repositories are public on GitHub.`,
    },
    cred: {
      h2: 'Local context, engineering depth, applied research.',
      points: ['Arabic-first AI', 'Local and private deployment options', 'Applied AI engineering', 'Domain-specific systems', 'Research-driven development'],
    },
    services: {
      h2: 'What we do',
      lead: 'From infrastructure to applied AI, Sudaverse works with institutions and companies along the whole path. Every engagement starts with a conversation about the problem.',
      cta: 'Discuss your needs',
    },
    products: {
      h2: 'Projects',
      lead: 'Every project below is live today.',
      more: 'More from Sudaverse',
    },
    eng: {
      h2: 'From raw text to a deployed model',
      lead: 'The pipeline behind Sudaverse language projects, from collection to deployment.',
      more: 'See the research directions behind it',
    },
    research: {
      h2: 'Research that becomes infrastructure.',
      lead: 'Peer-reviewed papers, open tools and six research directions that feed directly into Sudaverse projects.',
      papers: 'Published papers',
      allPapers: 'All papers',
      dir: 'Research directions',
      allDir: 'Explore the directions',
      artifact: 'Latest artifact',
    },
    company: 'Sudanese-founded. Globally connected. Building technology around local realities.',
    cta: {
      h2: 'Build with Sudaverse.',
      body: 'Working on a problem involving AI, data, cybersecurity, education, agriculture, digital health or digital infrastructure? Talk with our engineering team.',
    },
  },
  ar: {
    title: 'سودافيرس | ذكاء اصطناعي تطبيقي وأنظمة رقمية للسودان',
    description:
      'تبني سودافيرس منتجات ذكاء اصطناعي ومنصات رقمية عربية وعالمية في التعليم والزراعة والأمن السيبراني والمراقبة الجغرافية وتقنيات اللغة.',
    hero: {
      h1: ['ذكاء اصطناعي تطبيقي لأهم ', 'أنظمة السودان', '.'],
      lead: 'تبني سودافيرس منتجات ذكاء اصطناعي ومنصات رقمية عربية وعالمية في التعليم والزراعة والأمن السيبراني والمراقبة الجغرافية وتقنيات اللغة.',
    },
    about: {
      label: 'سودافيرس بنظرة سريعة',
      detail: ({ team, live, dev, repos }: Counts) =>
        `فريق من ${team} مهندسًا وباحثًا سودانيًا. ${live} منتجات متاحة${dev > 0 ? `، و${dev} منتجات أخرى قيد التطوير،` : '،'} و${repos} مستودعات مفتوحة المصدر علنية على GitHub.`,
    },
    cred: {
      h2: 'سياق محلي وعمق هندسي وبحث تطبيقي.',
      points: ['ذكاء اصطناعي عربي أولاً', 'خيارات نشر محلية وخاصة', 'هندسة ذكاء اصطناعي تطبيقي', 'أنظمة متخصصة بالمجال', 'تطوير مدفوع بالبحث'],
    },
    services: {
      h2: 'ما نقدّمه',
      lead: 'من البنية التحتية إلى الذكاء الاصطناعي التطبيقي، تعمل سودافيرس مع المؤسسات والشركات على امتداد الطريق كله. ويبدأ كل تعاون بحديث عن المشكلة.',
      cta: 'ناقش احتياجاتك',
    },
    products: {
      h2: 'المشاريع',
      lead: 'كل المشاريع أدناه متاحة اليوم.',
      more: 'المزيد من سودافيرس',
    },
    eng: {
      h2: 'من النص الخام إلى نموذج منشور',
      lead: 'خط المعالجة وراء مشاريع سودافيرس اللغوية، من الجمع حتى النشر.',
      more: 'اطلع على الاتجاهات البحثية وراءه',
    },
    research: {
      h2: 'بحث يتحول إلى بنية تحتية.',
      lead: 'أوراق محكّمة وأدوات مفتوحة وستة اتجاهات بحثية تغذّي مشاريع سودافيرس مباشرة.',
      papers: 'الأوراق المنشورة',
      allPapers: 'كل الأوراق',
      dir: 'الاتجاهات البحثية',
      allDir: 'استكشف الاتجاهات',
      artifact: 'أحدث مقال تقني',
    },
    company: 'تأسست في السودان. متصلة بالعالم. تبني التقنية حول الواقع المحلي.',
    cta: {
      h2: 'ابنِ مع سودافيرس.',
      body: 'هل تعمل على مشكلة تتعلق بالذكاء الاصطناعي أو البيانات أو الأمن السيبراني أو التعليم أو الزراعة أو الصحة الرقمية أو البنية الرقمية؟ تحدّث مع فريقنا الهندسي.',
    },
  },
}[locale];

const tutor = productBySlug('sudatutor')!;
const terab = productBySlug('terab')!;
const monitor = productBySlug('sudan-monitor')!;
const ndr = productBySlug('sudandr')!;
const more = ['sudaflood', 'sudata', 'urri', 'sudanizer', 'llmcorpuskit'].map((s) => productBySlug(s)!).filter(Boolean);
const counts: Counts = {
  team: team.length,
  live: products.filter((p) => p.stage === 'live' && p.slug !== 'llmcorpuskit').length,
  dev: products.filter((p) => p.stage === 'development').length,
  repos: openWork.length,
};
const productsHref = localePath(locale, 'projects');
const contactHref = localePath(locale, 'contact');
const servicesHref = `${contactHref}?topic=services`;
const latestArtifact = (await artifactsFor(locale))[0]?.entry;
const artifactHref = latestArtifact ? localePath(locale, `research/artifacts/${latestArtifact.data.permalink}`) : '';
---

<Base title={copy.title} description={copy.description} nav="home">
  <!-- 1. Hero -->
  <section class="hero" aria-labelledby="hero-h">
    <div class="container hero__grid">
      <div class="hero__text">
        <h1 id="hero-h">{copy.hero.h1[0]}<span class="hero__accent">{copy.hero.h1[1]}</span>{copy.hero.h1[2]}</h1>
        <p class="t-lead hero__lead">{copy.hero.lead}</p>
        <div class="cluster hero__cta">
          <Button href={productsHref} variant="primary" arrow>{t(locale, 'cta.exploreProjects')}</Button>
          <Button href={contactHref} variant="secondary">{t(locale, 'cta.talkToSudaverse')}</Button>
        </div>
        <a class="textlink" href={localePath(locale, 'research')}>
          {t(locale, 'cta.researchEngineering')}
          <Icon name="arrow" size={18} directional />
        </a>
      </div>
      <div class="hero__stage">
        <HeroStage locale={locale} />
      </div>
    </div>
  </section>

  <!-- 1a. Services at a glance -->
  <section class="svc" id="services" aria-labelledby="svc-h">
    <div class="container svc__grid">
      <div class="svc__head" data-reveal>
        <h2 id="svc-h">{copy.services.h2}</h2>
        <p class="t-lead">{copy.services.lead}</p>
        <Button href={servicesHref} variant="secondary" arrow>{copy.services.cta}</Button>
      </div>
      <ul role="list" class="svc__list" data-reveal>
        {
          offerings.map((o, i) => (
            <li>
              <a class="svc__row" href={`${servicesHref}&service=${o.id}`}>
                <span class="svc__icon" data-tone={i % 3}>
                  <Icon name={o.icon} size={22} />
                </span>
                <span class="svc__text">
                  <span class="svc__name">{L(o.name)}</span>
                  <span class="svc__sum">{L(o.summary)}</span>
                </span>
                <Icon name="arrow" size={18} directional class="svc__arrow" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 1b. Company statement and what sets the work apart, in one band (every number is counted from data) -->
  <section class="about" aria-label={copy.about.label}>
    <div class="container about__grid">
      <div class="about__main">
        <p class="about__lead">{copy.company}</p>
        <p class="about__detail">{copy.about.detail(counts)}</p>
        <a class="textlink" href={`${localePath(locale, 'about')}#team`}>
          {t(locale, 'cta.meetTeam')}
          <Icon name="arrow" size={18} directional />
        </a>
      </div>
      <div class="about__pts">
        <h2 class="about__h">{copy.cred.h2}</h2>
        <ul role="list" class="about__list">
          {copy.cred.points.map((p) => <li>{p}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <!-- 3. Flagship products -->
  <section class="products" aria-labelledby="products-h">
    <div class="container products__intro">
      <h2 id="products-h">{copy.products.h2}</h2>
      <p class="t-lead">{copy.products.lead}</p>
    </div>

    <!-- SudaTutor: the live product, shown with its logo -->
    <div class="fp fp--tutor">
      <div class="container fp__grid">
        <div class="fp__art" data-reveal>
          <ProductArt slug={tutor.slug} />
        </div>
        <div class="fp__body" data-reveal>
          <ProductPitch product={tutor} locale={locale} />
        </div>
      </div>
    </div>

    <!-- Terab: text-led on a mineral band, with its logo -->
    <div class="fp fp--terab">
      <div class="container fp__grid fp__grid--flip">
        <div class="fp__body" data-reveal>
          <ProductPitch product={terab} locale={locale} />
        </div>
        <div class="fp__art" data-reveal>
          <ProductArt slug={terab.slug} />
        </div>
      </div>
    </div>

    <!-- Sudan Monitor: its logo on a plain plate over a deep field -->
    <div class="fp fp--monitor on-deep section--deep">
      <div class="container fp__grid">
        <div class="fp__art" data-reveal>
          <ProductArt slug={monitor.slug} />
        </div>
        <div class="fp__body" data-reveal>
          <ProductPitch product={monitor} locale={locale} deep />
        </div>
      </div>
    </div>

    <!-- SudaNDR: compact ruled spotlight -->
    <div class="fp fp--ndr">
      <div class="container">
        <div class="ndr" data-reveal>
          <div class="ndr__art"><ProductArt slug={ndr.slug} /></div>
          <div class="ndr__body"><ProductPitch product={ndr} locale={locale} /></div>
        </div>
      </div>
    </div>

    <!-- The wider ecosystem -->
    <div class="container more" data-reveal>
      <h3 class="more__h">{copy.products.more}</h3>
      <ul role="list" class="more__list">
        {
          more.map((p) => (
            <li>
              <a class="more__row" href={localePath(locale, `projects/${p.slug}`)}>
                <span class="more__logo" aria-hidden="true">{p.logo && <Image src={p.logo} alt="" width={120} loading="lazy" />}</span>
                <span class="more__name" translate="no">{p.name}</span>
                <span class="more__tag">{L(p.tagline)}</span>
                <StageBadge stage={p.stage} locale={locale} />
                <Icon name="arrow" size={18} directional class="more__arrow" />
              </a>
            </li>
          ))
        }
      </ul>
      <p class="more__all"><a class="textlink" href={productsHref}>{t(locale, 'cta.seeAllProjects')}<Icon name="arrow" size={18} directional /></a></p>
    </div>
  </section>

  <!-- 5. Engineering: the pipeline diagram (the capabilities with their evidence live on the Solutions page) -->
  <section class="section eng" aria-labelledby="eng-h">
    <div class="container">
      <div class="head" data-reveal>
        <h2 id="eng-h">{copy.eng.h2}</h2>
        <p class="t-lead">{copy.eng.lead}</p>
      </div>
      <div class="flow" data-reveal>
        <PipelineFlow client:visible locale={locale} />
      </div>
      <p class="head__cta">
        <a class="textlink" href={localePath(locale, 'research/directions')}>
          {copy.eng.more}
          <Icon name="arrow" size={18} directional />
        </a>
      </p>
    </div>
  </section>

  <!-- 6. Research -->
  <section class="section section--alt" aria-labelledby="research-h">
    <div class="container">
      <div class="head" data-reveal>
        <h2 id="research-h">{copy.research.h2}</h2>
        <p class="t-lead">{copy.research.lead}</p>
      </div>
      <div class="res">
        <div class="res__open" data-reveal>
          <h3 class="res__h">{copy.research.papers}</h3>
          <ul role="list" class="res__list">
            {
              publications.map((p) => (
                <li class="res__item">
                  <p class="res__meta t-meta">
                    <span translate="no">{p.venue}</span>
                  </p>
                  <h4 class="res__name" translate="no">{p.title}</h4>
                  <p class="res__sum">{L(p.summary)}</p>
                </li>
              ))
            }
          </ul>
          <a class="textlink" href={localePath(locale, 'research/papers')}>
            {copy.research.allPapers}
            <Icon name="arrow" size={18} directional />
          </a>
          {
            latestArtifact && (
              <div class="res__art">
                <h3 class="res__h">{copy.research.artifact}</h3>
                <a class="art__row" href={artifactHref} lang={latestArtifact.data.lang} dir={latestArtifact.data.lang === 'ar' ? 'rtl' : 'ltr'}>
                  <span class="art__title">{latestArtifact.data.title}</span>
                  <span class="art__sum">{latestArtifact.data.summary}</span>
                </a>
              </div>
            )
          }
        </div>
        <div class="res__dir" data-reveal>
          <h3 class="res__h">{copy.research.dir}</h3>
          <ul role="list" class="dir">
            {
              directions.map((d) => (
                <li>
                  <a class="dir__row" href={`${localePath(locale, 'research/directions')}#${d.id}`} style={`--c:${d.color}`}>
                    <span class="dir__dot" aria-hidden="true" />
                    <span class="dir__t">{L(d.title)}</span>
                  </a>
                </li>
              ))
            }
          </ul>
          <a class="textlink" href={localePath(locale, 'research/directions')}>
            {copy.research.allDir}
            <Icon name="arrow" size={18} directional />
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 8. Final call to action -->
  <section class="section section--deep on-deep cta" aria-labelledby="cta-h">
    <div class="cta__art" aria-hidden="true"><TraceArt seed={5} tone="deep" traces={7} leaves={8} /></div>
    <div class="container cta__inner">
      <h2 id="cta-h">{copy.cta.h2}</h2>
      <p class="t-lead cta__body">{copy.cta.body}</p>
      <div class="cluster">
        <Button href={contactHref} variant="light" arrow>{t(locale, 'cta.talk')}</Button>
        <Button href={productsHref} variant="outline-deep">{t(locale, 'cta.exploreProjects')}</Button>
      </div>
    </div>
  </section>
</Base>

<style>
  h2 {
    max-inline-size: 20ch;
  }
  .head {
    display: grid;
    gap: var(--s-4);
    margin-block-end: var(--s-7);
  }
  .head h2 {
    max-inline-size: 22ch;
  }
  .head__cta {
    margin-block-start: var(--s-7);
    max-inline-size: none;
  }
  .textlink {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 2.75rem;
    font-weight: 620;
    text-decoration: none;
  }
  .textlink:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  /* ---- Hero ---- */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2rem, 0.75rem + 4vw, 4.25rem) var(--section-y-tight);
  }
  .hero__grid {
    position: relative;
    display: grid;
    align-items: center;
    gap: var(--s-7);
  }
  .hero__text {
    display: grid;
    gap: var(--s-5);
    align-content: center;
    justify-items: start;
  }
  .hero h1 {
    font-size: clamp(2.25rem, 1.15rem + 3vw, 3.5rem);
    line-height: var(--lh-tight);
    max-inline-size: 17ch;
  }
  .hero__accent {
    color: var(--brand-blue-600);
  }
  .hero__lead {
    max-inline-size: 44ch;
  }
  .hero__cta {
    gap: var(--s-3);
  }
  @media (max-width: 39.99rem) {
    .hero__cta {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      inline-size: 100%;
    }
    .hero__cta :global(.btn) {
      justify-content: center;
    }
  }
  .hero__stage {
    min-inline-size: 0;
  }
  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--s-7);
    }
  }

  /* ---- Services ---- */
  .svc {
    padding-block: var(--section-y-tight);
    background: var(--color-bg-alt);
  }
  .svc__grid {
    display: grid;
    gap: var(--s-7);
  }
  .svc__head {
    display: grid;
    gap: var(--s-4);
    align-content: start;
    justify-items: start;
  }
  .svc__head h2 {
    max-inline-size: 14ch;
  }
  .svc__list {
    display: grid;
    margin: 0;
    padding: 0;
    border-block-start: 1px solid var(--color-border-strong);
  }
  .svc__row {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: start;
    gap: var(--s-4);
    block-size: 100%;
    padding-block: var(--s-5);
    padding-inline: var(--s-1);
    border-block-end: 1px solid var(--color-border-strong);
    color: var(--ink);
    text-decoration: none;
  }
  /* A copper hairline draws in along the row's lower edge on hover and focus. */
  .svc__row::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: -1px;
    block-size: 1px;
    background: var(--color-accent-thread);
    transform: scaleX(0);
    transform-origin: left;
  }
  [dir='rtl'] .svc__row::after {
    transform-origin: right;
  }
  .svc__row:hover::after,
  .svc__row:focus-visible::after {
    transform: scaleX(1);
  }
  @media (prefers-reduced-motion: no-preference) {
    .svc__row::after {
      transition: transform var(--dur-4) var(--ease-out);
    }
    .svc__row :global(.svc__arrow) {
      transition: translate var(--dur-3) var(--ease-out), color var(--dur-2) var(--ease-out);
    }
  }
  .svc__row:hover {
    color: var(--ink);
  }
  .svc__icon {
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border-radius: var(--radius-2);
    background: color-mix(in srgb, var(--brand-blue) 16%, var(--white));
    color: var(--brand-blue-700);
  }
  .svc__icon[data-tone='1'] {
    background: color-mix(in srgb, var(--brand-green) 18%, var(--white));
    color: var(--brand-green-700);
  }
  .svc__icon[data-tone='2'] {
    background: var(--nile-100);
    color: var(--nile-800);
  }
  .svc__text {
    display: grid;
    gap: var(--s-1);
    min-inline-size: 0;
  }
  .svc__name {
    font-size: var(--fs-400);
    font-weight: 650;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-h3);
  }
  .svc__sum {
    font-size: var(--fs-200);
    line-height: 1.55;
    color: var(--color-text-muted);
  }
  .svc__row :global(.svc__arrow) {
    margin-block-start: 0.35rem;
    color: var(--color-text-meta);
  }
  .svc__row:hover :global(.svc__arrow),
  .svc__row:focus-visible :global(.svc__arrow) {
    color: var(--copper-700);
    translate: 0.2rem 0;
  }
  [dir='rtl'] .svc__row:hover :global(.svc__arrow),
  [dir='rtl'] .svc__row:focus-visible :global(.svc__arrow) {
    translate: -0.2rem 0;
  }
  @media (min-width: 48rem) {
    .svc__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--s-7);
    }
  }
  @media (min-width: 64rem) {
    .svc__grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: var(--s-8);
    }
    .svc__head {
      position: sticky;
      inset-block-start: calc(var(--header-h) + var(--s-6));
    }
  }

  /* ---- Company statement and what sets the work apart ---- */
  .about {
    padding-block: var(--section-y-tight);
  }
  .about__grid {
    display: grid;
    gap: var(--s-6);
    padding-block-start: var(--s-6);
    border-block-start: 1px solid var(--color-border-strong);
  }
  .about__main {
    display: grid;
    gap: var(--s-4);
    justify-items: start;
    align-content: start;
  }
