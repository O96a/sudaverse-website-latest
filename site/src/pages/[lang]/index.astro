---
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import HeroStage from '@/components/hero/HeroStage.astro';
import TraceArt from '@/components/TraceArt.astro';
import { offerings } from '@/data/services';
import { localePath, localeStaticPaths, t } from '@/i18n/utils';
import { pick, type Locale } from '@/i18n/config';

export function getStaticPaths() {
  return localeStaticPaths();
}
const locale = Astro.params.lang as Locale;
const L = (v: Parameters<typeof pick>[0]) => (pick(v as never, locale) as string | undefined) ?? '';

/*
 * The home page is the corporate front door, kept short and direct (owner direction, 2026-09-27): hero,
 * what we do, why Sudaverse, contact. Sectors live in the hero graph; projects, research and the company
 * story live under the header menus.
 */
const copy = {
  en: {
    title: 'Sudaverse | AI, data and cybersecurity services for Sudan',
    description:
      'Sudaverse is a Sudanese technology company providing AI adoption, cybersecurity, infrastructure, data and training services across healthcare, agriculture, education, geospatial intelligence and more.',
    hero: {
      h1: ['Applied AI and digital systems, ', 'built for Sudan', '.'],
      lead: 'We help institutions and companies adopt AI, secure their systems and build reliable digital infrastructure.',
      services: 'Our services',
    },
    services: {
      h2: 'What we do',
      lead: 'One engineering team, from infrastructure to applied AI. Every engagement starts with a conversation about your problem.',
    },
    why: {
      h2: 'Why Sudaverse',
      items: [
        { t: 'Built for Sudan', d: 'Sudanese engineers who work in Arabic and design around local realities.' },
        { t: 'Secure by design', d: 'Data, models and infrastructure are protected from the first decision.' },
        { t: 'Yours to run', d: 'Training and documentation leave your team owning what we deliver.' },
      ],
      team: 'Meet the team',
    },
    cta: {
      h2: 'Build with Sudaverse.',
      body: 'Tell us what you are working on, and our engineering team will reply by email.',
    },
  },
  ar: {
    title: 'سودافيرس | خدمات الذكاء الاصطناعي والبيانات والأمن السيبراني للسودان',
    description:
      'سودافيرس شركة تقنية سودانية تقدّم خدمات تبنّي الذكاء الاصطناعي والأمن السيبراني والبنية التحتية والبيانات والتدريب في الرعاية الصحية والزراعة والتعليم والمعلومات الجغرافية وغيرها.',
    hero: {
      h1: ['ذكاء اصطناعي تطبيقي وأنظمة رقمية، ', 'مبنية للسودان', '.'],
      lead: 'نساعد المؤسسات والشركات على تبنّي الذكاء الاصطناعي وتأمين أنظمتها وبناء بنية رقمية موثوقة.',
      services: 'خدماتنا',
    },
    services: {
      h2: 'ما نقدّمه',
      lead: 'فريق هندسي واحد، من البنية التحتية إلى الذكاء الاصطناعي التطبيقي. ويبدأ كل تعاون بحديث عن مشكلتكم.',
    },
    why: {
      h2: 'لماذا سودافيرس',
      items: [
        { t: 'مبنية للسودان', d: 'مهندسون سودانيون يعملون بالعربية ويصمّمون حول الواقع المحلي.' },
        { t: 'آمنة منذ التصميم', d: 'نحمي البيانات والنماذج والبنية التحتية من أول قرار.' },
        { t: 'ملكٌ لفريقكم', d: 'يترك التدريب والتوثيق فريقكم مالكًا لما نسلّمه وقادرًا على تشغيله.' },
      ],
      team: 'تعرّف على الفريق',
    },
    cta: {
      h2: 'ابنِ مع سودافيرس.',
      body: 'أخبرنا بما تعمل عليه، وسيردّ عليك فريقنا الهندسي عبر البريد الإلكتروني.',
    },
  },
}[locale];

const aboutHref = localePath(locale, 'about');
const contactHref = localePath(locale, 'contact');
const servicesHref = `${contactHref}?topic=services`;
---

<Base title={copy.title} description={copy.description} nav="home">
  <!-- 1. Hero: the sectors graph -->
  <section class="hero" aria-labelledby="hero-h">
    <div class="container hero__grid">
      <div class="hero__text">
        <h1 id="hero-h">{copy.hero.h1[0]}<span class="hero__accent">{copy.hero.h1[1]}</span>{copy.hero.h1[2]}</h1>
        <p class="t-lead hero__lead">{copy.hero.lead}</p>
        <div class="cluster hero__cta">
          <Button href="#services" variant="primary" arrow>{copy.hero.services}</Button>
          <Button href={contactHref} variant="secondary">{t(locale, 'cta.talkToSudaverse')}</Button>
        </div>
      </div>
      <div class="hero__stage">
        <HeroStage locale={locale} />
      </div>
    </div>
  </section>

  <!-- 2. What we do -->
  <section class="svc" id="services" aria-labelledby="svc-h">
    <div class="container">
      <div class="svc__head" data-reveal>
        <h2 id="svc-h">{copy.services.h2}</h2>
        <p class="t-lead">{copy.services.lead}</p>
      </div>
      <ul role="list" class="svc__list" data-reveal>
        {
          offerings.map((o, i) => (
            <li>
              <a class="svc__row" href={`${servicesHref}&service=${o.id}`}>
                <span class="svc__icon" data-tone={i % 3}>
                  <Icon name={o.icon} size={22} />
                </span>
                <span class="svc__text">
                  <span class="svc__name">{L(o.name)}</span>
                  <span class="svc__sum">{L(o.summary)}</span>
                </span>
                <Icon name="arrow" size={18} directional class="svc__arrow" />
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 3. Why Sudaverse -->
  <section class="why" aria-labelledby="why-h">
    <div class="container why__grid">
      <div class="why__head" data-reveal>
        <h2 id="why-h">{copy.why.h2}</h2>
        <a class="textlink" href={`${aboutHref}#team`}>
          {copy.why.team}
          <Icon name="arrow" size={18} directional />
        </a>
      </div>
      <ul role="list" class="why__list" data-reveal>
        {
          copy.why.items.map((v) => (
            <li>
              <h3 class="why__t">{v.t}</h3>
              <p class="why__d">{v.d}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 4. Contact -->
  <section class="section section--deep on-deep cta" aria-labelledby="cta-h">
    <div class="cta__art" aria-hidden="true"><TraceArt seed={5} tone="deep" traces={7} leaves={8} /></div>
    <div class="container cta__inner">
      <h2 id="cta-h">{copy.cta.h2}</h2>
      <p class="t-lead cta__body">{copy.cta.body}</p>
      <div class="cluster">
        <Button href={contactHref} variant="light" arrow>{t(locale, 'cta.talk')}</Button>
      </div>
    </div>
  </section>
</Base>

<style>
  h2 {
    max-inline-size: 20ch;
  }
  .textlink {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 2.75rem;
    font-weight: 620;
    text-decoration: none;
  }
  .textlink:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  /* ---- Hero ---- */
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2rem, 0.75rem + 4vw, 4.25rem) var(--section-y-tight);
  }
  .hero__grid {
    position: relative;
    display: grid;
    align-items: center;
    gap: var(--s-7);
  }
  .hero__text {
    display: grid;
    gap: var(--s-5);
    align-content: center;
    justify-items: start;
  }
  .hero h1 {
    font-size: clamp(2.25rem, 1.15rem + 3vw, 3.5rem);
    line-height: var(--lh-tight);
    max-inline-size: 17ch;
  }
  .hero__accent {
    color: var(--brand-blue-600);
  }
  .hero__lead {
    max-inline-size: 44ch;
  }
  .hero__cta {
    gap: var(--s-3);
  }
  @media (max-width: 39.99rem) {
    .hero__cta {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      inline-size: 100%;
    }
    .hero__cta :global(.btn) {
      justify-content: center;
    }
  }
  .hero__stage {
    min-inline-size: 0;
  }
  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--s-7);
    }
  }

  /* ---- Services ---- */
  .svc {
    padding-block: var(--section-y-tight);
    background: var(--color-bg-alt);
  }
  .svc__head {
    display: grid;
    gap: var(--s-3);
    margin-block-end: var(--s-6);
  }
  .svc__head h2 {
    max-inline-size: none;
  }
  .svc__head p {
    max-inline-size: 60ch;
  }
  .svc__list {
    display: grid;
    margin: 0;
    padding: 0;
    border-block-start: 1px solid var(--color-border-strong);
  }
  .svc__row {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: start;
    gap: var(--s-4);
    block-size: 100%;
    padding-block: var(--s-4);
    padding-inline: var(--s-1);
    border-block-end: 1px solid var(--color-border-strong);
    color: var(--ink);
    text-decoration: none;
  }
  /* A copper hairline draws in along the row's lower edge on hover and focus. */
  .svc__row::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: -1px;
    block-size: 1px;
    background: var(--color-accent-thread);
    transform: scaleX(0);
    transform-origin: left;
  }
  [dir='rtl'] .svc__row::after {
    transform-origin: right;
  }
  .svc__row:hover::after,
  .svc__row:focus-visible::after {
    transform: scaleX(1);
  }
  @media (prefers-reduced-motion: no-preference) {
    .svc__row::after {
      transition: transform var(--dur-4) var(--ease-out);
    }
    .svc__row :global(.svc__arrow) {
      transition: translate var(--dur-3) var(--ease-out), color var(--dur-2) var(--ease-out);
    }
  }
  .svc__row:hover {
    color: var(--ink);
  }
  .svc__icon {
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border-radius: var(--radius-2);
    background: color-mix(in srgb, var(--brand-blue) 16%, var(--white));
    color: var(--brand-blue-700);
  }
  .svc__icon[data-tone='1'] {
    background: color-mix(in srgb, var(--brand-green) 18%, var(--white));
    color: var(--brand-green-700);
  }
  .svc__icon[data-tone='2'] {
    background: var(--nile-100);
    color: var(--nile-800);
  }
  .svc__text {
    display: grid;
    gap: var(--s-1);
    min-inline-size: 0;
  }
  .svc__name {
    font-size: var(--fs-400);
    font-weight: 650;
    line-height: var(--lh-snug);
    letter-spacing: var(--tracking-h3);
  }
  .svc__sum {
    font-size: var(--fs-200);
    line-height: 1.55;
    color: var(--color-text-muted);
  }
  .svc__row :global(.svc__arrow) {
    margin-block-start: 0.35rem;
    color: var(--color-text-meta);
  }
  .svc__row:hover :global(.svc__arrow),
  .svc__row:focus-visible :global(.svc__arrow) {
    color: var(--copper-700);
    translate: 0.2rem 0;
  }
  [dir='rtl'] .svc__row:hover :global(.svc__arrow),
  [dir='rtl'] .svc__row:focus-visible :global(.svc__arrow) {
    translate: -0.2rem 0;
  }
  @media (min-width: 48rem) {
    .svc__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--s-7);
    }
  }
  @media (min-width: 64rem) {
    .svc__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      column-gap: var(--s-6);
    }
  }

  /* ---- Why Sudaverse: three short ruled statements ---- */
  .why {
    padding-block: var(--section-y-tight);
  }
  .why__grid {
    display: grid;
    gap: var(--s-5);
  }
  .why__head {
    display: grid;
    gap: var(--s-2);
    align-content: start;
    justify-items: start;
  }
  .why__list {
    display: grid;
    gap: 0 var(--s-6);
    margin: 0;
    padding: 0;
  }
  .why__list li {
    display: grid;
    gap: var(--s-2);
    align-content: start;
    padding-block: var(--s-4);
    border-block-start: 1px solid var(--color-border-strong);
  }
  .why__t {
    font-size: var(--fs-400);
    line-height: var(--lh-snug);
  }
  .why__d {
    color: var(--color-text-muted);
    font-size: var(--fs-200);
  }
  @media (min-width: 48rem) {
    .why__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (min-width: 64rem) {
    .why__grid {
      grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
      gap: var(--s-7);
    }
  }

  /* ---- Final CTA ---- */
  .cta {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .cta__art {
    position: absolute;
    inset-block: 0;
    inset-inline-end: 0;
    inline-size: min(60%, 46rem);
    opacity: 0.55;
    z-index: -1;
    mask-image: linear-gradient(to left, #000 30%, transparent);
  }
  [dir='rtl'] .cta__art {
    mask-image: linear-gradient(to right, #000 30%, transparent);
  }
  .cta__inner {
    display: grid;
    gap: var(--s-5);
  }
  .cta h2 {
    font-size: clamp(2.25rem, 1.4rem + 3vw, 3.75rem);
    line-height: var(--lh-tight);
    letter-spacing: var(--tracking-h1);
    max-inline-size: 14ch;
  }
  .cta__body {
    color: var(--color-text-on-deep-muted);
    max-inline-size: 52ch;
  }
</style>
