---
import type { GetStaticPathsOptions, Page } from 'astro';
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import Crumbs from '@/components/docs/Crumbs.astro';
import { NEWS_PAGE_SIZE, newsSorted, type NewsPost } from '@/data/news';
import { site } from '@/config/site';
import { localePath, t } from '@/i18n/utils';
import { locales, pick, type Locale } from '@/i18n/config';

/** /[lang]/news/ is page 1; further pages live at /[lang]/news/2/, /3/ and so on. */
export function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  return locales.flatMap((lang) => paginate(newsSorted, { params: { lang }, pageSize: NEWS_PAGE_SIZE }));
}
const locale = Astro.params.lang as Locale;
const { page } = Astro.props as { page: Page<NewsPost> };
const L = (v: Parameters<typeof pick>[0]) => (pick(v as never, locale) as string | undefined) ?? '';

const copy = {
  en: {
    title: 'News | Sudaverse',
    description: 'Product updates, open-source releases and company news from Sudaverse.',
    h1: 'News',
    lead: 'Product updates, open-source releases and company news from Sudaverse.',
    read: 'Read the post',
    by: 'By',
    follow: 'Follow Sudaverse',
    pages: 'News pages',
    prev: 'Newer',
    next: 'Older',
    pageOf: (n: number, total: number) => `Page ${n} of ${total}`,
    goto: (n: number) => `Go to page ${n}`,
  },
  ar: {
    title: 'الأخبار | سودافيرس',
    description: 'مستجدات المنتجات والإصدارات المفتوحة المصدر وأخبار الشركة من سودافيرس.',
    h1: 'الأخبار',
    lead: 'مستجدات المنتجات والإصدارات المفتوحة المصدر وأخبار الشركة من سودافيرس.',
    read: 'اقرأ المنشور',
    by: 'بقلم',
    follow: 'تابع سودافيرس',
    pages: 'صفحات الأخبار',
    prev: 'الأحدث',
    next: 'الأقدم',
    pageOf: (n: number, total: number) => `الصفحة ${n} من ${total}`,
    goto: (n: number) => `انتقل إلى الصفحة ${n}`,
  },
}[locale];

const fmt = (iso: string) => {
  const [y, m, d] = iso.split('-').map(Number);
  return new Date(Date.UTC(y, m - 1, d)).toLocaleDateString(locale === 'ar' ? 'ar-u-nu-latn' : 'en', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });
};

const base = localePath(locale, 'news');
const pageHref = (n: number) => (n === 1 ? base : `${base}${n}/`);
const paged = page.lastPage > 1;
const pageTitle = page.currentPage > 1 ? `${copy.title} (${copy.pageOf(page.currentPage, page.lastPage)})` : copy.title;

const abs = (p: string) => new URL(p, site.origin).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t(locale, 'misc.home'), item: abs(localePath(locale)) },
      { '@type': 'ListItem', position: 2, name: copy.h1, item: abs(base) },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Blog',
    name: copy.title,
    url: abs(pageHref(page.currentPage)),
    inLanguage: locale,
    blogPost: page.data.map((n) => ({
      '@type': 'BlogPosting',
      headline: L(n.title),
      datePublished: n.date,
      url: abs(localePath(locale, `news/${n.slug}`)),
    })),
  },
];
---

<Base title={pageTitle} description={copy.description} nav="news" jsonLd={jsonLd}>
  <div class="container">
    <Crumbs locale={locale} items={[{ label: copy.h1 }]} />
    <header class="head">
      <h1 id="news-h">{copy.h1}</h1>
      <p class="t-lead">{copy.lead}</p>
    </header>
  </div>

  <section class="section section--tight" aria-label={copy.h1}>
    <div class="container">
      <ol role="list" class="posts">
        {
          page.data.map((n) => (
            <li class="post">
              <div class="post__meta">
                <time datetime={n.date}>{fmt(n.date)}</time>
                <span class="post__cat" translate="no">{L(n.category)}</span>
              </div>
              <div class="post__body">
                <h2 class="post__title">
                  <a href={localePath(locale, `news/${n.slug}`)}>{L(n.title)}</a>
                </h2>
                <p class="post__sum">{L(n.summary)}</p>
                {n.author && <p class="post__by">{copy.by} {L(n.author)}</p>}
                <a class="textlink" href={localePath(locale, `news/${n.slug}`)}>
                  <span class="sr-only">{L(n.title)}: </span>
                  {copy.read}
                  <Icon name="arrow" size={18} directional />
                </a>
              </div>
            </li>
          ))
        }
      </ol>

      {
        paged && (
          <nav class="pager" aria-label={copy.pages}>
            {page.url.prev ? (
              <a class="pager__step" rel="prev" href={page.url.prev}>
                <Icon name="arrow" size={18} directional class="pager__flip" />
                {copy.prev}
              </a>
            ) : (
              <span class="pager__step is-off" aria-hidden="true">
                <Icon name="arrow" size={18} directional class="pager__flip" />
                {copy.prev}
              </span>
            )}
            <ol role="list" class="pager__nums">
              {Array.from({ length: page.lastPage }, (_, i) => i + 1).map((n) => (
                <li>
                  {n === page.currentPage ? (
                    <span class="pager__num is-current" aria-current="page">
                      <span class="sr-only">{copy.pageOf(n, page.lastPage)}</span>
                      <span aria-hidden="true">{n}</span>
                    </span>
                  ) : (
                    <a class="pager__num" href={pageHref(n)} aria-label={copy.goto(n)}>
                      {n}
                    </a>
                  )}
                </li>
              ))}
            </ol>
            {page.url.next ? (
              <a class="pager__step" rel="next" href={page.url.next}>
                {copy.next}
                <Icon name="arrow" size={18} directional />
              </a>
            ) : (
              <span class="pager__step is-off" aria-hidden="true">
                {copy.next}
                <Icon name="arrow" size={18} directional />
              </span>
            )}
          </nav>
        )
      }

      <p class="follow">
        <a class="textlink" href={site.social.linkedin} target="_blank" rel="noopener noreferrer">
          {copy.follow} (LinkedIn)
          <Icon name="external" size={16} />
          <span class="sr-only"> ({t(locale, 'a11y.external')})</span>
        </a>
      </p>
    </div>
  </section>
</Base>

<style>
  .head {
    display: grid;
    gap: var(--s-5);
    padding-block: var(--s-6) var(--s-7);
    justify-items: start;
  }
  .head h1 {
    max-inline-size: 14ch;
  }
  .posts {
    margin: 0;
    padding: 0;
    border-block-start: 1px solid var(--color-border-strong);
  }
  .post {
    display: grid;
    gap: var(--s-3) var(--s-7);
    padding-block: var(--s-6);
    border-block-end: 1px solid var(--color-border);
  }
  .post__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-3);
    color: var(--color-text-meta);
    font-size: var(--fs-200);
  }
  .post__cat {
    padding: 0.15rem 0.65rem;
    border-radius: var(--radius-pill);
    background: var(--color-stage-dev-bg);
    color: var(--color-stage-dev);
    font-size: var(--fs-100);
    font-weight: 650;
  }
  .post__body {
    display: grid;
    gap: var(--s-2);
    justify-items: start;
    max-inline-size: 62ch;
  }
  .post__title {
    font-size: var(--fs-500);
    line-height: var(--lh-snug);
  }
  .post__title a {
    color: var(--ink);
    text-decoration: none;
  }
  .post__title a:hover {
    color: var(--color-link);
  }
  .post__sum {
    color: var(--color-text-muted);
  }
  .post__by {
    font-size: var(--fs-200);
    color: var(--color-text-meta);
  }
  .follow {
    margin-block-start: var(--s-6);
  }
  .pager {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-3);
    margin-block-start: var(--s-6);
  }
  .pager__nums {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1);
    margin: 0;
    padding: 0;
  }
  .pager__num {
    display: inline-grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    color: var(--ink);
    font-weight: 620;
    text-decoration: none;
  }
  a.pager__num:hover {
    background: var(--paper-2);
  }
  .pager__num.is-current {
    background: var(--color-action);
    border-color: var(--color-action);
    color: var(--color-action-text);
  }
  .pager__step {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-block-size: 2.75rem;
    padding-inline: var(--s-3);
    font-weight: 620;
    text-decoration: none;
  }
  .pager__step.is-off {
    color: var(--color-text-meta);
    opacity: 0.55;
  }
  .pager :global(.pager__flip) {
    rotate: 180deg;
  }
  @media (min-width: 48rem) {
    .post {
      grid-template-columns: 13rem minmax(0, 1fr);
      align-items: start;
    }
    .post__meta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
