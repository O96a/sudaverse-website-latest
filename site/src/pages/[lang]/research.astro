---
/** Research hub: the three parts of Research (papers, artifacts, directions), each with its latest items. */
import { Picture } from 'astro:assets';
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import CtaBand from '@/components/products/CtaBand.astro';
import researchHall from '@/assets/photos/research-hall.jpg';
import { directions, publications } from '@/data/research';
import { artifactsFor } from '@/lib/artifacts';
import { site } from '@/config/site';
import { localePath, localeStaticPaths, t } from '@/i18n/utils';
import { pick, type Locale } from '@/i18n/config';

export function getStaticPaths() {
  return localeStaticPaths();
}
const locale = Astro.params.lang as Locale;
const L = (v: Parameters<typeof pick>[0]) => (pick(v as never, locale) as string | undefined) ?? '';

const copy = {
  en: {
    title: 'Research | Sudaverse',
    description: 'Research at Sudaverse: published papers, long technical artifacts and six research directions that feed Sudaverse projects.',
    h1: 'Research',
    lead: 'Research that becomes infrastructure. We choose our directions because our projects depend on the answers, and we publish what the work shows.',
    alt: 'Illustration: researchers seated in a lecture hall with laptops open, one showing a map of Sudan.',
    papers: { h: 'Published papers', d: 'Peer-reviewed papers from the Sudaverse team, with the open-source releases behind them.', all: 'All papers' },
    artifacts: { h: 'Artifacts', d: 'Long technical write-ups with data, diagrams and code, from benchmarks to system design.', all: 'All artifacts' },
    dirs: { h: 'Directions', d: 'Six research directions, and the projects each one feeds.', all: 'All directions' },
    cta: { h2: 'Working on related problems?', body: 'We welcome collaboration proposals from researchers, research groups and universities.', primary: 'Propose a collaboration' },
  },
  ar: {
    title: 'الأبحاث | سودافيرس',
    description: 'الأبحاث في سودافيرس: أوراق منشورة، ومقالات تقنية مطوّلة، وستة اتجاهات بحثية تغذّي مشاريع سودافيرس.',
    h1: 'الأبحاث',
    lead: 'بحث يتحول إلى بنية تحتية. نختار اتجاهاتنا لأن مشاريعنا تعتمد على إجاباتها، وننشر ما يكشفه العمل.',
    alt: 'رسم توضيحي: باحثون جالسون في قاعة محاضرات وحواسيبهم مفتوحة، يعرض أحدها خريطة السودان.',
    papers: { h: 'الأوراق المنشورة', d: 'أوراق محكّمة من فريق سودافيرس، والإصدارات المفتوحة المصدر التي تقف خلفها.', all: 'كل الأوراق' },
    artifacts: { h: 'مقالات تقنية', d: 'كتابات تقنية مطوّلة بالبيانات والمخططات والشيفرة، من معايير القياس إلى تصميم الأنظمة.', all: 'كل المقالات' },
    dirs: { h: 'الاتجاهات البحثية', d: 'ستة اتجاهات بحثية، والمشاريع التي يغذّيها كل منها.', all: 'كل الاتجاهات' },
    cta: { h2: 'تعمل على مشكلات مرتبطة؟', body: 'نرحّب بمقترحات التعاون من الباحثين والمجموعات البحثية والجامعات.', primary: 'اقترح تعاونًا' },
  },
}[locale];

const arts = (await artifactsFor(locale)).slice(0, 3);
const papersHref = localePath(locale, 'research/papers');
const artsHref = localePath(locale, 'research/artifacts');
const dirsHref = localePath(locale, 'research/directions');
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t(locale, 'misc.home'), item: `${site.origin}${localePath(locale)}` },
      { '@type': 'ListItem', position: 2, name: copy.h1, item: `${site.origin}${localePath(locale, 'research')}` },
    ],
  },
];
---

<Base title={copy.title} description={copy.description} nav="research" jsonLd={jsonLd}>
  <section class="hero" aria-labelledby="hero-h">
    <div class="container hero__grid">
      <div class="hero__text">
        <h1 id="hero-h">{copy.h1}</h1>
        <p class="t-lead">{copy.lead}</p>
      </div>
      <figure class="hero__photo">
        <Picture src={researchHall} formats={['avif', 'webp']} widths={[640, 960, 1040]} sizes="(min-width: 64rem) 46vw, 92vw" alt={copy.alt} loading="eager" fetchpriority="high" />
      </figure>
    </div>
  </section>

  <section class="section section--tight part" aria-labelledby="papers-h">
    <div class="container part__grid">
      <div class="part__head" data-reveal>
        <span class="part__icon"><Icon name="paper" size={22} /></span>
        <h2 id="papers-h">{copy.papers.h}</h2>
        <p>{copy.papers.d}</p>
        <a class="textlink" href={papersHref}>{copy.papers.all}<Icon name="arrow" size={18} directional /></a>
      </div>
      <ul role="list" class="rows" data-reveal>
        {
          publications.map((p) => (
            <li class="row">
              <span class="t-meta" translate="no">{p.venue}</span>
              <a class="row__t" href={`${papersHref}#${p.id}`} translate="no">{p.title}</a>
              <span class="row__d">{L(p.summary)}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--tight section--alt part" aria-labelledby="arts-h">
    <div class="container part__grid">
      <div class="part__head" data-reveal>
        <span class="part__icon"><Icon name="chart" size={22} /></span>
        <h2 id="arts-h">{copy.artifacts.h}</h2>
        <p>{copy.artifacts.d}</p>
        <a class="textlink" href={artsHref}>{copy.artifacts.all}<Icon name="arrow" size={18} directional /></a>
      </div>
      <ul role="list" class="rows" data-reveal>
        {
          arts.map(({ entry }) => (
            <li class="row" lang={entry.data.lang} dir={entry.data.lang === 'ar' ? 'rtl' : 'ltr'}>
              <span class="t-meta">{entry.data.date.toLocaleDateString(entry.data.lang === 'ar' ? 'ar-u-nu-latn' : 'en', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}</span>
              <a class="row__t" href={localePath(locale, `research/artifacts/${entry.data.permalink}`)}>{entry.data.title}</a>
              <span class="row__d">{entry.data.summary}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--tight part" aria-labelledby="dirs-h">
    <div class="container part__grid">
      <div class="part__head" data-reveal>
        <span class="part__icon"><Icon name="network" size={22} /></span>
        <h2 id="dirs-h">{copy.dirs.h}</h2>
        <p>{copy.dirs.d}</p>
        <a class="textlink" href={dirsHref}>{copy.dirs.all}<Icon name="arrow" size={18} directional /></a>
      </div>
      <ul role="list" class="rows rows--dirs" data-reveal>
        {
          directions.map((d) => (
            <li class="row" style={`--c:${d.color}`}>
              <a class="row__t row__t--dir" href={`${dirsHref}#${d.id}`}>
                <span class="dot" aria-hidden="true" />
                {L(d.title)}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand id="research-cta-h" heading={copy.cta.h2} body={copy.cta.body} primary={{ href: `${localePath(locale, 'contact')}?topic=research`, label: copy.cta.primary }} seed={21} />
</Base>

<style>
  .hero {
    padding-block: clamp(2rem, 1rem + 3vw, 3.5rem) var(--section-y-tight);
  }
  .hero__grid {
    display: grid;
    gap: var(--s-7);
    align-items: center;
  }
  .hero__text {
    display: grid;
    gap: var(--s-4);
  }
  .hero__photo :global(img) {
    inline-size: 100%;
    block-size: auto;
    border-radius: var(--radius-1);
  }
  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
      gap: var(--s-8);
    }
  }
  .part__grid {
    display: grid;
    gap: var(--s-6);
  }
  .part__head {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    justify-items: start;
  }
  .part__head p {
    color: var(--color-text-muted);
  }
  .part__icon {
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border-radius: var(--radius-2);
    background: var(--nile-100);
    color: var(--nile-800);
  }
  .rows {
    display: grid;
    margin: 0;
    padding: 0;
    border-block-start: 1px solid var(--color-border-strong);
  }
  .row {
    display: grid;
    gap: var(--s-1);
    padding-block: var(--s-4);
    border-block-end: 1px solid var(--color-border);
  }
  .row__t {
    font-size: var(--fs-400);
    font-weight: 650;
    line-height: var(--lh-snug);
    color: var(--ink);
    text-decoration: none;
  }
  .row__t:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .row__d {
    font-size: var(--fs-200);
    color: var(--color-text-muted);
  }
  .rows--dirs .row {
    padding-block: var(--s-2);
  }
  .row__t--dir {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    min-block-size: 2.75rem;
    font-size: var(--fs-300);
    font-weight: 600;
  }
  .dot {
    flex: none;
    inline-size: 0.625rem;
    block-size: 0.625rem;
    border-radius: 50%;
    background: var(--c);
  }
  @media (min-width: 64rem) {
    .part__grid {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: var(--s-8);
    }
    .rows--dirs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--s-6);
    }
  }
</style>
