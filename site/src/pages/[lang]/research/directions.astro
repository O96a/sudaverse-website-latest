---
/**
 * Research directions: an animated map (Sudaverse research, six directions, the projects they feed), then
 * one ruled section per direction with its summary, topics, projects, papers and artifacts.
 */
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import Crumbs from '@/components/docs/Crumbs.astro';
import CtaBand from '@/components/products/CtaBand.astro';
import HierarchyFlow from '@/components/flow/HierarchyFlow';
import type { HierNode } from '@/components/flow/hierarchy-layout';
import { directions, papersFor } from '@/data/research';
import { productBySlug, products } from '@/data/products';
import { artifactsFor } from '@/lib/artifacts';
import { site } from '@/config/site';
import { localePath, localeStaticPaths, t } from '@/i18n/utils';
import { pick, type Locale } from '@/i18n/config';

export function getStaticPaths() {
  return localeStaticPaths();
}
const locale = Astro.params.lang as Locale;
const L = (v: Parameters<typeof pick>[0]) => (pick(v as never, locale) as string | undefined) ?? '';

const copy = {
  en: {
    title: 'Research directions | Sudaverse',
    description: 'Six research directions at Sudaverse, from Arabic NLP for Sudanese dialects to adversarial security and AI cognitive architectures, and the projects each one feeds.',
    h1: 'Research directions',
    lead: 'Six directions, chosen because our projects depend on the answers. The map shows which projects each direction feeds.',
    root: 'Sudaverse research',
    mapLabel: 'Map: Sudaverse research, its six directions and the projects each one feeds',
    topics: 'Topics',
    feeds: 'Feeds these projects',
    exploratory: 'Exploratory: not yet tied to a project.',
    papers: 'Papers',
    artifacts: 'Artifacts',
    cta: { h2: 'Research with us.', body: 'If your work touches one of these directions, tell us what you have in mind and the team will reply by email.', primary: 'Propose a collaboration' },
  },
  ar: {
    title: 'الاتجاهات البحثية | سودافيرس',
    description: 'ستة اتجاهات بحثية في سودافيرس، من معالجة العربية للهجات السودانية إلى الأمن العدائي والمعماريات الإدراكية، والمشاريع التي يغذّيها كل منها.',
    h1: 'الاتجاهات البحثية',
    lead: 'ستة اتجاهات اخترناها لأن مشاريعنا تعتمد على إجاباتها. وتُظهر الخريطة المشاريع التي يغذّيها كل اتجاه.',
    root: 'أبحاث سودافيرس',
    mapLabel: 'خريطة: أبحاث سودافيرس واتجاهاتها الستة والمشاريع التي يغذّيها كل منها',
    topics: 'الموضوعات',
    feeds: 'يغذّي هذه المشاريع',
    exploratory: 'اتجاه استكشافي: لم يرتبط بمشروع بعد.',
    papers: 'الأوراق',
    artifacts: 'المقالات التقنية',
    cta: { h2: 'ابحث معنا.', body: 'إن كان عملك يمسّ أحد هذه الاتجاهات، أخبرنا بما تفكر فيه وسيردّ عليك الفريق عبر البريد الإلكتروني.', primary: 'اقترح تعاونًا' },
  },
}[locale];

const dirHref = (id: string) => `#${id}`;
const nodes: HierNode[] = [
  { id: 'root', label: copy.root },
  ...directions.map((d) => ({ id: d.id, label: L(d.short), parents: ['root'], color: d.color, href: dirHref(d.id) })),
  ...products
    .filter((p) => directions.some((d) => d.projects.includes(p.slug)))
    .map((p) => ({
      id: p.slug,
      label: p.name,
      parents: directions.filter((d) => d.projects.includes(p.slug)).map((d) => d.id),
      href: localePath(locale, `projects/${p.slug}`),
    })),
];
const arts = await artifactsFor(locale);
const papersHref = localePath(locale, 'research/papers');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t(locale, 'misc.home'), item: `${site.origin}${localePath(locale)}` },
      { '@type': 'ListItem', position: 2, name: t(locale, 'nav.research'), item: `${site.origin}${localePath(locale, 'research')}` },
      { '@type': 'ListItem', position: 3, name: copy.h1, item: `${site.origin}${localePath(locale, 'research/directions')}` },
    ],
  },
];
---

<Base title={copy.title} description={copy.description} nav="research" jsonLd={jsonLd}>
  <section class="head" aria-labelledby="dir-h">
    <div class="container">
      <Crumbs locale={locale} items={[{ label: t(locale, 'nav.research'), href: localePath(locale, 'research') }, { label: copy.h1 }]} />
      <div class="head__text">
        <h1 id="dir-h">{copy.h1}</h1>
        <p class="t-lead">{copy.lead}</p>
      </div>
      <div class="map">
        <HierarchyFlow client:visible locale={locale} nodes={nodes} label={copy.mapLabel} />
        <noscript>
          <ul>
            {directions.map((d) => <li><a href={dirHref(d.id)}>{L(d.title)}</a>: {d.projects.map((s) => productBySlug(s)?.name).join(', ')}</li>)}
          </ul>
        </noscript>
      </div>
    </div>
  </section>

  <div class="dirs">
    {
      directions.map((d, i) => {
        const ps = papersFor(d.id);
        const as = arts.filter((a) => a.entry.data.direction === d.id);
        return (
          <section class:list={['section', 'section--tight', 'dir', { 'section--alt': i % 2 === 0 }]} id={d.id} aria-labelledby={`${d.id}-h`} style={`--c:${d.color}`}>
            <div class="container dir__grid">
              <div class="dir__head" data-reveal>
                <span class="dir__icon"><Icon name={d.icon} size={22} /></span>
                <h2 id={`${d.id}-h`}>{L(d.title)}</h2>
                <p class="dir__sum">{L(d.summary)}</p>
              </div>
              <div class="dir__body" data-reveal>
                <h3 class="dir__k">{copy.topics}</h3>
                <ul role="list" class="dir__topics">
                  {d.topics.map((tp) => <li>{L(tp)}</li>)}
                </ul>
                <h3 class="dir__k">{copy.feeds}</h3>
                {d.projects.length ? (
                  <ul role="list" class="dir__links">
                    {d.projects.map((s) => {
                      const p = productBySlug(s)!;
                      return (
                        <li>
                          <a href={localePath(locale, `projects/${s}`)}>
                            <span translate="no">{p.name}</span>
                            <Icon name="arrow" size={16} directional />
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                ) : (
                  <p class="t-small t-muted">{copy.exploratory}</p>
                )}
                {ps.length > 0 && (
                  <>
                    <h3 class="dir__k">{copy.papers}</h3>
                    <ul role="list" class="dir__refs">
                      {ps.map((p) => (
                        <li>
                          <a href={`${papersHref}#${p.id}`} translate="no" lang="en" dir="ltr">{p.title}</a>
                          <span class="t-meta" translate="no">{p.venue}</span>
                        </li>
                      ))}
                    </ul>
                  </>
                )}
                {as.length > 0 && (
                  <>
                    <h3 class="dir__k">{copy.artifacts}</h3>
                    <ul role="list" class="dir__refs">
                      {as.map(({ entry }) => (
                        <li lang={entry.data.lang}>
                          <a href={localePath(locale, `research/artifacts/${entry.data.permalink}`)}>{entry.data.title}</a>
                        </li>
                      ))}
                    </ul>
                  </>
                )}
              </div>
            </div>
          </section>
        );
      })
    }
  </div>

  <CtaBand id="dir-cta-h" heading={copy.cta.h2} body={copy.cta.body} primary={{ href: `${localePath(locale, 'contact')}?topic=research`, label: copy.cta.primary }} seed={33} />
</Base>

<style>
  .head {
    padding-block: var(--s-4) var(--section-y-tight);
  }
  .head__text {
    display: grid;
    gap: var(--s-4);
    margin-block: var(--s-5) var(--s-7);
  }
  .map {
    min-inline-size: 0;
  }
  .dir {
    scroll-margin-block-start: var(--header-h);
  }
  .dir__grid {
    display: grid;
    gap: var(--s-6);
  }
  .dir__head {
    display: grid;
    gap: var(--s-3);
    align-content: start;
    justify-items: start;
  }
  .dir__head h2 {
    font-size: var(--fs-500);
    max-inline-size: 24ch;
  }
  .dir__icon {
    display: grid;
    place-items: center;
    inline-size: 2.75rem;
    block-size: 2.75rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--c) 16%, var(--white));
    color: var(--ink);
    box-shadow: inset 0 0 0 1.5px var(--c);
  }
  .dir__sum {
    color: var(--color-text-muted);
  }
  .dir__body {
    display: grid;
    gap: var(--s-2);
    align-content: start;
  }
  .dir__k {
    margin-block-start: var(--s-3);
    font-size: var(--fs-100);
    font-weight: 650;
    letter-spacing: var(--tracking-meta);
    color: var(--color-text-meta);
  }
  .dir__k:first-child {
    margin-block-start: 0;
  }
  .dir__topics,
  .dir__refs {
    display: grid;
    margin: 0;
    padding: 0;
    border-block-start: 1px solid var(--color-border-strong);
  }
  .dir__topics li,
  .dir__refs li {
    display: grid;
    gap: var(--s-1);
    padding-block: var(--s-3);
    border-block-end: 1px solid var(--color-border);
  }
  .dir__refs a {
    font-weight: 620;
    color: var(--ink);
  }
  .dir__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
  }
  .dir__links a {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    min-block-size: 2.5rem;
    padding-inline: var(--s-4);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    font-size: var(--fs-200);
    font-weight: 620;
    color: var(--ink);
    text-decoration: none;
  }
  .dir__links a:hover {
    background: var(--paper-2);
    color: var(--ink);
  }
  @media (min-width: 64rem) {
    .dir__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: var(--s-8);
    }
  }
</style>
