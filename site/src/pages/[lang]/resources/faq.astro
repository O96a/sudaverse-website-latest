---
import Base from '@/layouts/Base.astro';
import Icon from '@/components/Icon.astro';
import Crumbs from '@/components/docs/Crumbs.astro';
import CtaBand from '@/components/products/CtaBand.astro';
import { faqGroups, faqItems } from '@/data/faq';
import { products } from '@/data/products';
import { site } from '@/config/site';
import { localePath, localeStaticPaths, t } from '@/i18n/utils';
import { pick, type Locale } from '@/i18n/config';

export function getStaticPaths() {
  return localeStaticPaths();
}
const locale = Astro.params.lang as Locale;
const L = (v: Parameters<typeof pick>[0]) => (pick(v as never, locale) as string | undefined) ?? '';

const copy = {
  en: {
    title: 'Frequently asked questions',
    description:
      'Answers about what Sudaverse builds, which products are available today, deployment options, research and how to work with the team.',
    h1: 'Frequently asked questions',
    lead: 'Straight answers about what Sudaverse builds, what is available today and how to work with us.',
    index: 'Question groups',
    cta: {
      h2: 'Still have a question?',
      body: 'Tell us about your project. Your message goes to the Sudaverse team.',
      primary: t('en', 'cta.talk'),
      secondary: t('en', 'cta.exploreProducts'),
    },
  },
  ar: {
    title: 'الأسئلة الشائعة | سودافيرس',
    description:
      'إجابات عن ما تبنيه سودافيرس، والمنتجات المتاحة اليوم، وخيارات النشر، والبحث، وكيفية العمل مع الفريق.',
    h1: 'الأسئلة الشائعة',
    lead: 'إجابات مباشرة عما تبنيه سودافيرس، وما هو متاح اليوم، وكيف يمكنك العمل معنا.',
    index: 'مجموعات الأسئلة',
    cta: {
      h2: 'ما زال لديك سؤال؟',
      body: 'أخبرنا عن مشروعك. ستصل رسالتك إلى فريق سودافيرس.',
      primary: t('ar', 'cta.talk'),
      secondary: t('ar', 'cta.exploreProducts'),
    },
  },
}[locale];

/** Escape, then wrap brand names and emails so they stay Latin and untranslated inside Arabic text. */
const escapeHtml = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const escapeRe = (s: string) => s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
const brandNames = [...products.map((p) => p.name), 'Sudaverse Normalizer'].sort((a, b) => b.length - a.length);
const brandRe = new RegExp(`(${brandNames.map(escapeRe).join('|')}|[\\w.+-]+@[\\w-]+\\.[\\w.]+)`, 'g');
const rich = (text: string) =>
  escapeHtml(text).replace(brandRe, (m) =>
    m.includes('@') ? `<bdi dir="ltr" translate="no">${m}</bdi>` : `<bdi translate="no">${m}</bdi>`,
  );

const linkHref = (path: string) => {
  const [base, extra] = path.split(/(?=[?#])/);
  return `${localePath(locale, base)}${extra ?? ''}`;
};

const abs = (p: string) => new URL(p, site.origin).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: t(locale, 'misc.home'), item: abs(localePath(locale)) },
      { '@type': 'ListItem', position: 2, name: t(locale, 'nav.resources'), item: abs(localePath(locale, 'resources')) },
      { '@type': 'ListItem', position: 3, name: copy.h1, item: abs(localePath(locale, 'resources/faq')) },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((it) => ({
      '@type': 'Question',
      name: L(it.q),
      acceptedAnswer: { '@type': 'Answer', text: L(it.a) },
    })),
  },
];
---

<Base title={copy.title} description={copy.description} nav="resources" jsonLd={jsonLd}>
  <div class="container">
    <Crumbs
      locale={locale}
      items={[{ label: t(locale, 'nav.resources'), href: localePath(locale, 'resources') }, { label: copy.h1 }]}
    />
    <header class="head">
      <h1 id="faq-h">{copy.h1}</h1>
      <p class="t-lead">{copy.lead}</p>
    </header>
  </div>

  <div class="container faq">
    <nav class="faq__index" aria-label={copy.index}>
      <ul role="list">
        {
          faqGroups.map((g) => (
            <li>
              <a href={`#${g.id}`}>{L(g.title)}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="faq__groups">
      {
        faqGroups.map((g) => (
          <section class="group" id={g.id} aria-labelledby={`${g.id}-h`}>
            <h2 id={`${g.id}-h`}>{L(g.title)}</h2>
            <div class="group__list">
              {g.items.map((it) => (
                <details class="q" name="faq">
                  <summary>
                    <span class="q__text">{L(it.q)}</span>
                    <Icon name="chevron" size={20} class="q__chev" />
                  </summary>
                  <div class="q__body">
                    <p set:html={rich(L(it.a))} />
                    {it.links && (
                      <div class="q__links">
                        {it.links.map((l) => (
                          <a class="textlink" href={linkHref(l.path)}>
                            {L(l.label)}
                            <Icon name="arrow" size={16} directional />
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                </details>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>

  <CtaBand
    id="faq-cta"
    heading={copy.cta.h2}
    body={copy.cta.body}
    primary={{ href: localePath(locale, 'contact'), label: copy.cta.primary }}
    secondary={{ href: localePath(locale, 'products'), label: copy.cta.secondary }}
    seed={17}
  />
</Base>

<style>
  .head {
    display: grid;
    gap: var(--s-5);
    padding-block: var(--s-6) var(--s-7);
    justify-items: start;
  }
  .head h1 {
    max-inline-size: 16ch;
  }
  .faq {
    display: grid;
    gap: var(--s-7);
    padding-block-end: var(--section-y);
  }
  .faq__index ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin: 0;
    padding: 0;
  }
  .faq__index a {
    display: inline-flex;
    align-items: center;
    min-block-size: 2.75rem;
    padding-inline: var(--s-4);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    color: var(--ink);
    font-size: var(--fs-200);
    font-weight: 560;
    text-decoration: none;
  }
  .faq__index a:hover {
    background: var(--paper-2);
  }
  .faq__groups {
    display: grid;
    gap: var(--s-8);
    min-inline-size: 0;
  }
  .group {
    scroll-margin-block-start: calc(var(--header-h) + var(--s-5));
  }
  .group h2 {
    margin-block-end: var(--s-5);
    font-size: var(--fs-500);
  }
  .group__list {
    border-block-start: 1px solid var(--color-border-strong);
  }
  .q {
    border-block-end: 1px solid var(--color-border);
  }
  .q summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    min-block-size: 3.75rem;
    padding-block: var(--s-3);
    color: var(--ink);
    font-size: var(--fs-400);
    font-weight: 620;
    line-height: var(--lh-snug);
    list-style: none;
    cursor: pointer;
  }
  .q summary::-webkit-details-marker {
    display: none;
  }
  .q summary:hover .q__text {
    color: var(--color-link);
  }
  .q :global(.q__chev) {
    flex: none;
    color: var(--color-text-meta);
  }
  .q[open] :global(.q__chev) {
    rotate: 180deg;
  }
  @media (prefers-reduced-motion: no-preference) {
    .q :global(.q__chev) {
      transition: rotate var(--dur-2) var(--ease-out);
    }
  }
  .q__body {
    display: grid;
    gap: var(--s-3);
    padding-block-end: var(--s-5);
  }
  .q__body p {
    margin: 0;
    max-inline-size: 62ch;
    color: var(--color-text-muted);
  }
  .q__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s-5);
  }
  @media (min-width: 64rem) {
    .faq {
      grid-template-columns: minmax(0, 3fr) minmax(0, 8fr);
      gap: var(--s-8);
      align-items: start;
    }
    .faq__index {
      position: sticky;
      inset-block-start: calc(var(--header-h) + var(--s-5));
    }
    .faq__index ul {
      flex-direction: column;
      align-items: flex-start;
    }
    .faq__index a {
      border-color: transparent;
      padding-inline: 0;
      border-radius: 0;
    }
    .faq__index a:hover {
      background: none;
      text-decoration: underline;
      text-underline-offset: 0.25em;
    }
  }
</style>
